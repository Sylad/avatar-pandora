---
/**
 * Texte courant (L74) : chaque long mot collé à une espace insécable isolé dans
 * un `<span>` nu, pour que la césure du navigateur puisse le couper avec son trait (lib/prose-breaks.ts). Rendu inchangé
 * quand la césure est éteinte. Noms de personnes en `<span class="prose-name">`, jamais césurés (L74 r1).
 */
import { proseSegments, segmentHtml } from '../lib/prose-breaks';

interface Props {
  text: string;
}
const { text } = Astro.props;
---
<Fragment set:html={proseSegments(text).map(segmentHtml).join('')} />
