---
import EywaLogo from './EywaLogo.astro';
import NewsBadge from './NewsBadge.astro';
import TitleText from './TitleText.astro';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const sections = [
  { slug: 'pandora', label: 'Pandora', href: '/pandora/' },
  { slug: 'clans', label: 'Clans Na\'vi', href: '/clans/' },
  { slug: 'bestiaire', label: 'Bestiaire', href: '/bestiaire/' },
  { slug: 'flore', label: 'Flore', href: '/flore/' },
  { slug: 'personnages', label: 'Personnages', href: '/personnages/' },
  { slug: 'langue', label: 'Langue Na\'vi', href: '/langue/' },
  { slug: 'films', label: 'Les films', href: '/films/' },
  { slug: 'engins', label: 'Engins', href: '/engins/' },
  { slug: 'videos', label: 'Vidéos', href: '/videos/' },
];
---
<!--
  Tiroir : slide-in depuis la gauche, contrôlé par data-drawer-open sur <html>.
  Bouton burger et overlay vivent dans CodexLayout.
  Barre latérale : 20 rem, collante. Le mode vient d'une requête de conteneur en em
  (L69, voir CodexLayout) : texte agrandi à 1024 px → tiroir.
-->
<aside
  id="eywa-sidebar"
  class="eywa-sidebar fixed inset-y-0 left-0 z-50 w-80 shrink-0 h-screen overflow-y-auto px-6 py-10 flex flex-col -translate-x-full transition-transform duration-300 ease-out"
  aria-label="Navigation du codex"
>
  <a href="/" class="eywa-sidebar__brand block mb-10 group">
    <EywaLogo size={200} />
    <span class="block text-xs uppercase text-eywa-text-muted mt-2">Codex de Pandora</span>
  </a>

  <nav class="flex flex-col gap-1" aria-label="Sections du codex">
    {sections.map((s) => (
      <a
        href={s.href}
        class:list={[
          'eywa-nav-link block px-3 py-2 rounded text-sm font-display tracking-wide transition-all duration-300',
          current === s.slug
            ? 'is-active bg-eywa-bio-primary/10 text-eywa-bio-primary shadow-[0_0_20px_-2px_rgba(95,255,230,0.30)]'
            : 'text-eywa-text-muted hover:text-eywa-bio-primary hover:bg-eywa-bio-primary/5 hover:shadow-[0_0_18px_-4px_rgba(95,255,230,0.40)]',
        ]}
        aria-current={current === s.slug ? 'page' : undefined}
        aria-label={s.label}
      >
        <TitleText text={s.label} />
      </a>
    ))}
  </nav>

  <div class="eywa-about mt-auto pt-6">
    <div class="eywa-about__divider" aria-hidden="true"></div>
    <!-- Nouveautés (L14) : lien « méta » comme À propos, juste au-dessus. -->
    <a
      href="/nouveautes/"
      class:list={['eywa-about__link', { 'is-active': current === 'nouveautes' }]}
      aria-current={current === 'nouveautes' ? 'page' : undefined}
    >
      <svg class="eywa-about__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9-1.9 5.1-1.9-5.1-5.1-1.9 5.1-1.9z" />
        <path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" />
      </svg>
      <span>Nouveautés</span>
      <!-- Pastille : entrées non vues depuis la dernière visite (script de BaseLayout). -->
      <NewsBadge />
    </a>
    <!-- Plan de travail (L20) : juste après Nouveautés — ce qui arrive, après ce qui est arrivé. -->
    <a
      href="/plan-de-travail/"
      class:list={['eywa-about__link', { 'is-active': current === 'plan' }]}
      aria-current={current === 'plan' ? 'page' : undefined}
    >
      <svg class="eywa-about__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6.5l1.6 1.6L8.5 5" />
        <path d="M4 12.5l1.6 1.6 2.9-3.1" />
        <circle cx="6" cy="18.5" r="1.6" />
        <path d="M11.5 6.5H20M11.5 12.5H20M11.5 18.5H20" />
      </svg>
      <span>Plan de travail</span>
    </a>
    <a href="/about/" class="eywa-about__link">
      <svg class="eywa-about__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9.5" />
        <path d="M12 11v5" />
        <circle cx="12" cy="7.75" r="0.9" fill="currentColor" stroke="none" />
      </svg>
      <span>À propos</span>
    </a>
  </div>
</aside>


<style>
  /* Bioluminescent right edge: faint always, brighter via the inner shadow.
     Replaces the plain border-r so the sidebar feels alive. */
  .eywa-sidebar {
    border-right: 1px solid rgba(95, 255, 230, 0.18);
    box-shadow:
      inset -1px 0 0 rgba(95, 255, 230, 0.10),
      1px 0 30px -8px rgba(95, 255, 230, 0.18);
    /* Sur mobile (drawer fixed), opaque pour ne pas voir le main à travers. */
    background: rgba(8, 12, 22, 0.96);
    backdrop-filter: blur(8px);
  }

  /* Drawer ouvert sur mobile : translation à 0. Sur lg+, déjà à 0. */
  /* Tailwind 4 décale le tiroir avec la propriété `translate` (-translate-x-full) :
     c'est elle qu'il faut remettre à zéro, `transform` seul le laissait hors champ (L14).
     Pas de `transform` à côté : le minifieur CSS de Vite 8 (Astro 7, L59) fusionnait
     `transform: translateX(0); translate: 0 0` en un seul `transform`, et `translate`
     restait à -100 % — le tiroir ne s'ouvrait plus. */
  :global(html[data-drawer-open="true"]) .eywa-sidebar {
    translate: 0 0;
  }

  /* Tiroir : il (20rem) ne dépasse jamais l'écran, même à 320 px. */
  .eywa-sidebar {
    max-width: 88vw;
  }
  /* L78 r2 (QA de prod du 25-11) — gabarit très étroit pour son texte (seuil de CodexLayout, 10,75 em : 320 px texte
     175 et 200 % ; jamais un réglage à 100 %) : le tiroir prend toute la largeur de la page, marges à leur taille du
     réglage normal. Avec la police réglée à 28 ou 32 px dans le navigateur, les liens grandissent avec elle (30,6 px à
     200 %), et dans 88vw moins 2 × 1,5 rem de marge « Personnages », « Nouveautés », « Pandora » se cassaient lettre à
     lettre. Le bouton menu (croix) reste au-dessus du tiroir, en haut à droite, et le referme. */
  /* Libellés des sections en boîtes de mots (TitleText, `aria-label` sans U+00AD) : un mot plus large que le tiroir
     (« Personnages », Orbitron à 30,6 px) se coupe à ses syllabes, avec un trait, jamais lettre à lettre. */
  @container eywa-codex (max-width: 10.75em) {
    .eywa-sidebar {
      max-width: 100%;
      padding-inline: 0.5rem;
    }
    .eywa-nav-link {
      padding-inline: 0.5rem;
      letter-spacing: normal;
    }
    /* Liens du bas (Nouveautés, Plan de travail, À propos) : le libellé passe sous l'icône s'il n'a pas la place à côté
       (« Nouveautés », 28 px à 200 %, n'avait que 160 px à côté de l'icône). */
    .eywa-sidebar .eywa-about__link {
      flex-wrap: wrap;
      padding-inline: 0.5rem;
      letter-spacing: normal;
    }
  }

  /* Barre latérale (L69 : même double condition que CodexLayout) : collante, dans le flux. */
  @media (min-width: 64rem) {
    @container eywa-codex (min-width: 44em) {
      .eywa-sidebar {
        position: sticky;
        top: 0;
        translate: none;
        max-width: none;
      }
    }
  }

  /* Bureaux bas (1366×768, 1280×720) : avec « Plan de travail » (L20), la barre latérale
     compte 12 liens ; marges haute/basse et sous le logo resserrées pour qu'ils tiennent
     tous dans l'écran sans défiler (À propos passait 9 px sous le bord à 1280×720). */
  @media (min-width: 64rem) and (max-height: 820px) {
    @container eywa-codex (min-width: 44em) {
      .eywa-sidebar {
        padding-top: 1.5rem;
        padding-bottom: 1.25rem;
      }
      .eywa-sidebar__brand {
        margin-bottom: 1.5rem;
      }
    }
  }

  /* Bureau : barre collante posée sur l'ambiance (particules WebGL, halo du curseur, mousse).
     Transparente jusqu'à L67, une particule claire passait derrière un libellé et le faisait tomber
     jusqu'à 1,0:1 (WCAG 1.4.3). Voile de nuit à 88 % : la plus claire des particules ressort au plus
     à rgb(37,41,49) sous le texte (≥ 7:1 pour les libellés atténués) ; le pollen reste deviné à
     travers, et un reflet cyan très bas descend le long du bord lumineux. Mesuré par
     scripts/codex-menu-contrast.e2e.test.mjs. */
  @media (min-width: 64rem) {
    @container eywa-codex (min-width: 44em) {
      .eywa-sidebar {
        background:
          linear-gradient(to left, rgba(95, 255, 230, 0.035), transparent 45%),
          rgba(8, 12, 22, 0.88);
        backdrop-filter: none;
      }
    }
  }

  /* Active nav item slowly breathes — Pandora's pulse. */
  .eywa-nav-link.is-active {
    animation: eywa-breath 4s ease-in-out infinite;
  }

  @keyframes eywa-breath {
    0%, 100% {
      box-shadow: 0 0 18px -2px rgba(95, 255, 230, 0.25);
    }
    50% {
      box-shadow: 0 0 28px 0px rgba(95, 255, 230, 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eywa-nav-link.is-active {
      animation: none;
    }
    /* Mouvement réduit (L70, revue UX de L69, WCAG 2.3.3) : le tiroir apparaît et disparaît sans glisser. */
    .eywa-sidebar {
      transition: none;
    }
  }

  /*
    "À propos" footer link — explicitly distinct from the 9 codex sections
    above. A faint cyan divider above it severs it from the nav list, an
    info icon signals its meta nature, and the typography is bumped to the
    same .text-sm as the nav links (was .text-xs at 60% opacity, basically
    invisible on a wide sidebar). On hover the icon glows like every other
    bioluminescent affordance on the site.
  */
  .eywa-about__divider {
    height: 1px;
    margin: 0 0.25rem 0.85rem;
    background: linear-gradient(
      to right,
      transparent,
      rgba(95, 255, 230, 0.30),
      transparent
    );
  }

  /* Un lien par ligne (Nouveautés puis À propos), largeur de son contenu. */
  .eywa-about__link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-eywa-text-muted);
    border-radius: 4px;
    transition: color 300ms ease, background-color 300ms ease, box-shadow 300ms ease;
  }

  .eywa-about__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-eywa-bio-primary);
    opacity: 0.75;
    transition: opacity 300ms ease, filter 300ms ease;
  }

  .eywa-about__link.is-active {
    color: var(--color-eywa-bio-primary);
    background-color: rgba(95, 255, 230, 0.10);
  }

  .eywa-about__link:hover {
    color: var(--color-eywa-bio-primary);
    background-color: rgba(95, 255, 230, 0.06);
    box-shadow: 0 0 18px -6px rgba(95, 255, 230, 0.50);
  }

  /* Focus clavier (L67) : même lueur que le survol, plus un anneau net (WCAG 2.4.7). */
  .eywa-nav-link:focus-visible,
  .eywa-about__link:focus-visible {
    color: var(--color-eywa-bio-primary);
    outline: 2px solid var(--color-eywa-bio-primary);
    outline-offset: 2px;
  }

  .eywa-about__link:hover .eywa-about__icon {
    opacity: 1;
    filter: drop-shadow(0 0 6px rgba(95, 255, 230, 0.65));
  }
</style>
