---
/*
  Ikrans dans le ciel (L34, « Pandora vivant 3 », prototype validé par Sylvain le 10-10) : de temps
  en temps, une silhouette d'ikran (ou deux) traverse le bandeau des sections Pandora et Bestiaire ;
  un toucher ou un clic sur le bandeau en appelle un. Logique pure : lib/ikran.ts.

  • Calque posé DANS le bandeau (SectionHero), entre l'image et le voile : l'ikran prend la lumière
    du voile comme l'image, et le texte reste au-dessus de lui. `pointer-events: none` : le calque
    ne prend aucun clic ; c'est le bandeau qui écoute le toucher.
  • Fondu à l'entrée et à la sortie (opacité de chaque ikran ; pas de masque sur le calque).
  • Web Animations sur transform et opacity seulement ; chaque ikran est retiré à la fin de sa
    traversée. Rien ne tourne hors de l'écran ni dans un onglet caché (pas de nouveau passage).
  • Pause de l'ambiance (AtmospherePause) : les ikrans en vol se figent, aucun nouveau ne part,
    même au toucher. Mouvement réduit : aucune traversée, rien n'est dessiné.
  • Au doigt, seul un toucher bref et immobile appelle un ikran : un glissement (défilement) non.
*/
---

<div class="ikran-sky" data-ikran-sky aria-hidden="true"></div>

<script>
  import { ATMOSPHERE_EVENT, ATMOSPHERE_PAUSED_CLASS } from './cinema/atmosphere-clock';
  import { isTap, type MossStep } from '../lib/bio-moss';
  import {
    FIRST_PASS_MS, IKRAN_SVG, MAX_IKRANS, MAX_WITH_TAPS, flapKeyframes, flightKeyframes, ikranSize, ikranSpeed,
    nextPassDelay, skyBand, swayOf,
  } from '../lib/ikran';

  /** Relevés pour les tests : ikrans partis en tout, dont ceux appelés par un toucher. */
  interface SkyStats { spawned: number; tapped: number }
  const w = window as Window & { __eywaIkranInit?: boolean; __eywaIkran?: SkyStats };

  // ClientRouter : ce module ne s'exécute qu'une fois ; le calque est retrouvé à chaque page.
  if (!w.__eywaIkranInit) {
    w.__eywaIkranInit = true;
    const stats: SkyStats = (w.__eywaIkran = { spawned: 0, tapped: 0 });
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const FLAP = flapKeyframes();
    const WINGS = [
      ['.ikran__wing--front-up', FLAP.frontUp],
      ['.ikran__wing--front-down', FLAP.frontDown],
      ['.ikran__wing--rear-up', FLAP.rearUp],
      ['.ikran__wing--rear-down', FLAP.rearDown],
      ['.ikran__tail', FLAP.tail],
    ] as const;

    interface Bird { node: HTMLElement; anims: Animation[] }
    let sky: HTMLElement | null = null;
    let hero: HTMLElement | null = null;
    let inView = false;
    let timer = 0;
    let touch: (MossStep & { id: number }) | null = null;
    const birds: Bird[] = [];
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) inView = e.isIntersecting;
      schedule(FIRST_PASS_MS);
    });

    const paused = () => document.documentElement.classList.contains(ATMOSPHERE_PAUSED_CLASS);
    const active = () => !!sky && !reduced.matches && !paused();

    const remove = (b: Bird) => {
      for (const a of b.anims) a.cancel();
      b.node.remove();
      const i = birds.indexOf(b);
      if (i >= 0) birds.splice(i, 1);
    };

    /** Haut du texte du bandeau, dans le repère du calque. */
    const textTop = () => {
      if (!sky || !hero) return 0;
      const o = sky.getBoundingClientRect();
      let top = Infinity;
      for (const el of hero.querySelectorAll('.section-hero__content > *')) top = Math.min(top, el.getBoundingClientRect().top);
      return Number.isFinite(top) ? top - o.top : o.height;
    };

    const launch = (opt: { dir?: 1 | -1; y?: number; depth?: number; tapped?: boolean } = {}) => {
      if (!sky || !active()) return null;
      if (birds.length >= (opt.tapped ? MAX_WITH_TAPS : MAX_IKRANS)) return null;
      const W = sky.clientWidth, H = sky.clientHeight;
      if (!W || !H) return null;
      const depth = opt.depth ?? Math.random();
      const size = ikranSize(depth, W);
      const [lo, hi] = skyBand(H, textTop(), size);
      const y = Math.min(hi, Math.max(lo, opt.y ?? lo + Math.random() * (hi - lo)));
      const dir = opt.dir ?? (Math.random() < 0.5 ? 1 : -1);
      const node = document.createElement('div');
      node.className = 'ikran';
      node.innerHTML = IKRAN_SVG;
      node.style.width = node.style.height = `${size.toFixed(1)}px`;
      const flight = flightKeyframes({
        width: W, size, y, dir, speed: ikranSpeed(depth, W), opacity: 0.6 + 0.4 * depth,
        sway: swayOf(H, size), phase: Math.random() * Math.PI * 2,
      });
      sky.append(node);
      const anims: Animation[] = [node.animate(flight.frames, { duration: flight.duration, easing: 'linear', fill: 'both' })];
      // Chaque ikran bat des ailes à son rythme : départ à un endroit tiré au hasard de la salve.
      const offset = -Math.random() * FLAP.duration;
      for (const [sel, frames] of WINGS) {
        const g = node.querySelector<HTMLElement>(sel);
        if (g) anims.push(g.animate(frames as Keyframe[], { duration: FLAP.duration, iterations: Infinity, delay: offset, easing: 'linear' }));
      }
      const bird = { node, anims };
      birds.push(bird);
      anims[0].finished.then(() => remove(bird), () => {});
      stats.spawned++;
      if (opt.tapped) stats.tapped++;
      return { dir, y, depth };
    };

    const pass = () => {
      const first = launch();
      // Parfois un second, un peu derrière et plus loin : un couple d'ikrans.
      if (first && Math.random() < 0.35) {
        window.setTimeout(() => launch({ dir: first.dir, y: first.y + 24, depth: Math.max(0, first.depth - 0.25) }), 600 + Math.random() * 900);
      }
    };

    function schedule(delay: number) {
      clearTimeout(timer);
      timer = 0;
      if (!active() || !inView || document.hidden) return;
      timer = window.setTimeout(() => {
        timer = 0;
        if (active() && inView && !document.hidden) pass();
        schedule(nextPassDelay(Math.random()));
      }, delay);
    }

    const clear = () => {
      clearTimeout(timer);
      timer = 0;
      while (birds.length) remove(birds[0]);
    };

    const callAt = (clientX: number, clientY: number) => {
      if (!sky || !active()) return;
      const r = sky.getBoundingClientRect();
      // Entre du côté le plus proche du doigt, à son altitude (ramenée dans le ciel).
      launch({ dir: clientX - r.left < r.width / 2 ? 1 : -1, y: clientY - r.top, depth: 0.6 + Math.random() * 0.4, tapped: true });
    };

    const onDown = (e: PointerEvent) => {
      if (e.pointerType === 'touch') { touch = { id: e.pointerId, x: e.clientX, y: e.clientY, t: e.timeStamp }; return; }
      if (e.button === 0) callAt(e.clientX, e.clientY);
    };
    const onUp = (e: PointerEvent) => {
      if (e.pointerType !== 'touch' || !touch || touch.id !== e.pointerId) return;
      const down = touch;
      touch = null;
      if (isTap(down, { x: e.clientX, y: e.clientY, t: e.timeStamp })) callAt(down.x, down.y);
    };
    const onCancel = () => { touch = null; };

    const unmount = () => {
      clear();
      io.disconnect();
      if (hero) {
        hero.removeEventListener('pointerdown', onDown);
        hero.removeEventListener('pointerup', onUp);
        hero.removeEventListener('pointercancel', onCancel);
      }
      sky = hero = null;
      inView = false;
    };

    const mount = () => {
      unmount();
      sky = document.querySelector<HTMLElement>('[data-ikran-sky]');
      hero = sky?.closest<HTMLElement>('.section-hero') ?? null;
      if (!sky || !hero) { sky = hero = null; return; }
      hero.addEventListener('pointerdown', onDown, { passive: true });
      hero.addEventListener('pointerup', onUp, { passive: true });
      hero.addEventListener('pointercancel', onCancel, { passive: true });
      io.observe(hero);
    };

    window.addEventListener(ATMOSPHERE_EVENT, () => {
      for (const b of birds) for (const a of b.anims) (paused() ? a.pause() : a.play());
      schedule(FIRST_PASS_MS);
    });
    reduced.addEventListener('change', () => { if (reduced.matches) clear(); else schedule(FIRST_PASS_MS); });
    document.addEventListener('visibilitychange', () => schedule(FIRST_PASS_MS));
    document.addEventListener('astro:before-swap', unmount);
    document.addEventListener('astro:page-load', mount);
    mount();
  }
</script>

<style>
  .ikran-sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Pas de masque de fondu sur le calque : il faisait recomposer toute la surface masquée à chaque
       image. Le fondu d'entrée et de sortie est dans l'opacité de chaque ikran (flightKeyframes). */
  }
  .ikran-sky :global(.ikran) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
  }
  /* Une couche par partie (lib/ikran.ts) : ailes et queue animées sur le compositeur. */
  .ikran-sky :global(.ikran > div) {
    position: absolute;
    inset: 0;
  }
  .ikran-sky :global(.ikran svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Épaules et base de la queue (lib/ikran.ts, IKRAN_PIVOTS : 108, 84 et 56 sur 200 ; y = 100). */
  .ikran-sky :global(.ikran__wing--front-up),
  .ikran-sky :global(.ikran__wing--front-down) { transform-origin: 54% 50%; }
  .ikran-sky :global(.ikran__wing--rear-up),
  .ikran-sky :global(.ikran__wing--rear-down) { transform-origin: 42% 50%; }
  .ikran-sky :global(.ikran__tail) { transform-origin: 28% 50%; }
  /* Liseré bioluminescent : sans lui, la silhouette sombre se perdait sur un ciel nuit ou spatial
     (bandeau Pandora, visuel par défaut du Bestiaire). */
  .ikran-sky :global(.ikran__skin) { fill: #10233a; stroke: rgba(95, 255, 230, 0.4); stroke-width: 1.3; stroke-linejoin: round; }
  .ikran-sky :global(.ikran__body) { fill: #0a1524; stroke: rgba(95, 255, 230, 0.3); stroke-width: 1; stroke-linejoin: round; }
  .ikran-sky :global(.ikran__tail-line) { fill: none; stroke: #0a1524; stroke-width: 3; stroke-linecap: round; }
  .ikran-sky :global(.ikran__stripe) { fill: none; stroke: rgba(95, 255, 230, 0.55); stroke-width: 1.6; stroke-linecap: round; }
  .ikran-sky :global(.ikran__stripe--orange) { stroke: rgba(255, 140, 42, 0.55); stroke-width: 1.4; }
  @media (prefers-reduced-motion: reduce) {
    .ikran-sky { display: none; }
  }
</style>
