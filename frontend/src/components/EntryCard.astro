---
interface Props {
  href: string;
  title: string;
  summary: string;
  cover?: string;
}
import CoverFallback from './CoverFallback.astro';
import { coverCardSrc, isIllustration, ILLUSTRATION_SIZES } from '../lib/cover';
import { titleBreaks } from '../lib/title-breaks';

const { href, title, summary, cover } = Astro.props;
// Image hébergée par le site ou visuel par défaut (proxy Fandom retiré, L16).
// Illustration du site (L17) : sa taille carte (4:3, plus légère). L'image
// reste décorative (alt vide) : le titre de la carte nomme déjà le lien, et la
// fiche porte la description de l'image.
const imgSrc = coverCardSrc(cover);
const size = isIllustration(cover) ? ILLUSTRATION_SIZES.carte : undefined;

// Spores de la carte éveillée (L33, prototype « Pandora vivant » du 10-10) :
// positions, tailles, couleurs et rythmes tirés d'un générateur à graine (l'adresse
// de la fiche), pour un rendu identique d'un build à l'autre et sans script.
const SPORE_COLORS = ['#5fffe6', '#7fff8f', '#aa82ff', '#ff5dc4'];
const SPORE_COUNT = 12;
let seed = 2166136261;
for (const ch of href) seed = Math.imul(seed ^ ch.charCodeAt(0), 16777619) >>> 0;
const rand = () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const spores = Array.from({ length: SPORE_COUNT }, (_, i) => {
  const d = 2.4 + rand() * 2.2;
  return [
    `--x:${(4 + rand() * 92).toFixed(1)}%`,
    `--s:${(3 + rand() * 5).toFixed(1)}px`,
    `--c:${SPORE_COLORS[i % SPORE_COLORS.length]}`,
    `--d:${d.toFixed(2)}s`,
    `--delay:${(-rand() * d).toFixed(2)}s`,
    `--dx:${Math.round((rand() - 0.5) * 50)}px`,
    // Hauteur figée en mouvement réduit : les spores restent visibles, immobiles.
    `--y:${Math.round(20 + rand() * 60)}%`,
  ].join(';');
});
---
<a href={href} class="entry-card group">
  {imgSrc ? (
    <div class="entry-card__media">
      <img src={imgSrc}
           alt=""
           width={size?.width}
           height={size?.height}
           loading="lazy"
           decoding="async"
           class="entry-card__img" />
      <span class="entry-card__spores" aria-hidden="true">
        {spores.map((style) => <span class="entry-card__spore" style={style}></span>)}
      </span>
    </div>
  ) : (
    <div class="entry-card__media">
      <div class="entry-card__fallback"><CoverFallback size={96} /></div>
      <span class="entry-card__spores" aria-hidden="true">
        {spores.map((style) => <span class="entry-card__spore" style={style}></span>)}
      </span>
    </div>
  )}
  <div class="entry-card__body">
    <h2 class="entry-card__title" aria-label={title}>{titleBreaks(title)}</h2>
    <p class="entry-card__summary">{summary}</p>
  </div>
</a>

<style>
  /*
    Cartes qui s'éveillent (L33, « Pandora vivant 2 », prototype validé par Sylvain le 10-10).
    Au repos, la carte DORT : image dans la pénombre (luminosité 0,55, saturation 0,7), liseré
    à peine allumé. Elle S'ÉVEILLE au survol (souris), au clavier (:focus-visible) et au toucher
    (.is-awake, posée par le script au contact du doigt) : liseré qui pulse, image qui s'éclaire,
    lueur qui monte du bas de l'image, titre cyan, spores qui montent.
    Le texte (titre, résumé) garde le même contraste dans les deux états : seul l'image dort.
    Mouvement réduit : aucune animation ni transition, l'état éveillé reste lisible (liseré,
    image éclairée, titre cyan, spores immobiles). Pause de l'ambiance : tout se fige.
  */
  .entry-card {
    position: relative;
    display: block;
    border-radius: 6px;
    /* Pas d'overflow: hidden ici : il couperait la lueur des calques ::before/::after.
       L'image est coupée par .entry-card__media, les coins arrondis par le média et le corps. */
    background: rgba(232, 230, 221, 0.02);
    border: 1px solid rgba(95, 255, 230, 0.15);
    box-shadow:
      0 0 0 1px rgba(95, 255, 230, 0.04) inset,
      0 0 18px -8px rgba(95, 255, 230, 0.20);
    transition:
      border-color 450ms ease,
      box-shadow 450ms ease,
      transform 450ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .entry-card:focus-visible {
    outline: 2px solid var(--color-eywa-bio-primary);
    outline-offset: 4px;
  }

  /* Media area — 4:3 */
  .entry-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-eywa-bg);
    overflow: hidden;
    border-radius: 5px 5px 0 0;
  }

  /* L'image dort dans la pénombre. */
  .entry-card__img,
  .entry-card__fallback {
    display: block;
    width: 100%;
    height: 100%;
    filter: brightness(0.55) saturate(0.7);
    transform: scale(1);
    transition: filter 700ms ease, transform 1200ms ease;
  }
  .entry-card__img { object-fit: cover; }
  .entry-card__fallback { position: absolute; inset: 0; }

  /* Lueur qui monte du bas de l'image à l'éveil. */
  .entry-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 75% 60% at 50% 100%,
      rgba(95, 255, 230, 0.32),
      rgba(127, 255, 143, 0.10) 45%,
      transparent 72%);
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .entry-card__spores {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .entry-card__spore {
    position: absolute;
    bottom: -8px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0, var(--c) 40%, transparent 72%);
    box-shadow: 0 0 8px var(--c);
    opacity: 0;
  }

  /*
    ---- Éveil : UN seul sélecteur pour le survol, le clavier et le toucher ----
    `:hover:not(.is-touched)` : un appareil tactile garde un « survol collé » après le toucher ;
    le script pose .is-touched sur la carte touchée (et l'ôte dès qu'une vraie souris la survole),
    si bien que seul un pointeur qui survole vraiment éveille la carte par :hover.
  */
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched)) {
    border-color: rgba(95, 255, 230, 0.7);
    box-shadow: 0 0 0 1px rgba(95, 255, 230, 0.14) inset;
    transform: translateY(-3px);
  }
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched)) :is(.entry-card__img, .entry-card__fallback) {
    filter: brightness(1.08) saturate(1.25);
    transform: scale(1.06);
  }
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched)) .entry-card__media::after { opacity: 1; }
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched)) .entry-card__title {
    color: var(--color-eywa-bio-primary);
    text-shadow: 0 0 16px rgba(95, 255, 230, 0.6);
  }
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched)) .entry-card__spore {
    animation: entry-card-spore var(--d) linear var(--delay) infinite;
  }

  /*
    Pouls du liseré : deux calques de lueur, figés, en fondu enchaîné sur la seule `opacity`
    (le compositeur l'anime sans repeindre). ::before porte la lueur de base de l'éveil,
    ::after la lueur la plus forte du pouls ; décalés d'une demi-période, leurs opacités font
    toujours 1, comme l'ancien box-shadow animé de la base au pic (prototype du 10-10).
  */
  .entry-card::before,
  .entry-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 450ms ease;
  }
  .entry-card::before {
    box-shadow:
      0 0 36px -4px rgba(95, 255, 230, 0.5),
      0 0 70px -12px rgba(127, 255, 143, 0.3);
  }
  .entry-card::after {
    box-shadow:
      0 0 46px 0 rgba(95, 255, 230, 0.62),
      0 0 90px -10px rgba(127, 255, 143, 0.38);
  }
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched))::before {
    opacity: 1;
    animation: entry-card-rim 2.6s ease-in-out -1.3s infinite;
  }
  .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched))::after {
    animation: entry-card-rim 2.6s ease-in-out infinite;
  }

  @keyframes entry-card-rim {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }
  @keyframes entry-card-spore {
    0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
    15% { opacity: 1; }
    70% { opacity: 0.85; }
    100% { transform: translate(var(--dx), -230px) scale(1); opacity: 0; }
  }

  /*
    Tap → bloom (L30) : au toucher, le script pose .is-blooming 200 ms (éclat plus fort)
    pendant que le ClientRouter charge déjà la fiche — l'éclat ne retarde jamais la
    navigation (Nielsen 1). Placé APRÈS l'éveil : son animation remplace le pouls du liseré.
  */
  .entry-card.is-blooming {
    border-color: rgba(95, 255, 230, 0.75);
    box-shadow:
      0 0 0 1px rgba(95, 255, 230, 0.20) inset,
      0 0 48px -2px rgba(95, 255, 230, 0.65),
      0 0 90px -10px rgba(127, 255, 143, 0.45);
    animation: entry-card-bloom 200ms ease-out;
  }
  .entry-card.is-blooming .entry-card__img,
  .entry-card.is-blooming .entry-card__fallback {
    transform: scale(1.08);
    filter: saturate(1.20) brightness(1.12);
  }
  .entry-card.is-blooming .entry-card__media::after { opacity: 1; }
  .entry-card.is-blooming::before,
  .entry-card.is-blooming::after {
    animation: none;
    opacity: 0;
    transition: none;
  }
  .entry-card.is-blooming .entry-card__title {
    color: var(--color-eywa-bio-primary);
    text-shadow: 0 0 18px rgba(95, 255, 230, 0.65);
  }

  @keyframes entry-card-bloom {
    0% { transform: translateY(0) scale(1); }
    25% { transform: translateY(-3px) scale(1.015); }
    100% { transform: translateY(-2px) scale(1.01); }
  }

  /* Pause de l'ambiance (WCAG 2.2.2) : le liseré et les spores se figent. */
  :global(:root.eywa-atmo-paused) .entry-card,
  :global(:root.eywa-atmo-paused) .entry-card::before,
  :global(:root.eywa-atmo-paused) .entry-card::after,
  :global(:root.eywa-atmo-paused) .entry-card__spore {
    animation-play-state: paused !important;
  }

  /* Body */
  .entry-card__body {
    position: relative;
    z-index: 2;
    padding: 1.25rem;
    border-radius: 0 0 5px 5px;
    /* Voile sombre sous le texte (L27, WCAG 1.4.3) : les particules WebGL passent
       derrière la carte, le résumé ne doit pas les voir (même principe que L2). */
    background: rgba(10, 10, 31, 0.88);
    /* Cadre du titre (L70) : la césure ne s'allume que dans une carte trop étroite pour le plus long mot. */
    container: eywa-card / inline-size;
  }
  /* L71 — gabarit du codex très étroit pour son texte (320 px texte 175 et 200 %, seuil de CodexLayout) : marges
     latérales réduites, « Mo'at'ite » (4,8 em du titre) et « (2009) » tiennent dans la carte. */
  @container eywa-codex (max-width: 10.75em) {
    .entry-card__body {
      padding-inline: 0.75rem;
    }
  }

  /* Taille en rem : le titre grandit avec le texte (WCAG 1.4.4 ; revue UX de L70, un plafond en cqi le laissait à
     117 % à 390 px texte 200 %, plus petit que le résumé). Un mot plus long que la carte (« bioluminescente »,
     9,74 em du titre = 10,96 em de la carte, dans une colonne unique de 390 px texte 200 %) se coupe à une coupure
     de titleBreaks, avec son trait (`hyphens: manual` depuis L72) ; « overflow-wrap: anywhere » des h2 (global.css) reste
     le secours. Césure seulement sous 11 em : dans la grille (colonnes ≥ 14,5 em, 12 em de texte), tous les mots
     tiennent, et la césure partout aurait coupé des titres au réglage normal (« Palulu-kan » à 1280 px).
     Hors de ce cas, `hyphens: none` rend inertes les coupures conditionnelles de titleBreaks (lib/title-breaks.ts). */
  .entry-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    hyphens: none;
    /* L72 : jamais moins de 3 lettres de part et d'autre d'une coupure (même règle dans titleBreaks). `hyphens: manual` :
       le navigateur ne coupe qu'aux U+00AD de titleBreaks, jamais à son dictionnaire (« Ts-kaha »). */
    hyphenate-limit-chars: 6 3 3;
    color: var(--color-eywa-text);
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
    transition: color 400ms ease, text-shadow 400ms ease;
  }
  @container eywa-card (max-width: 11em) {
    .entry-card__title {
      hyphens: manual;
    }
  }
  /* L74 : les noms de personnes ne se coupent plus. « Ateyo'itan » (235 px pour une ligne de 231 à 320 et 390 px texte
     200 %) se cassait « Ateyo'ita / n » : sous 7 em de contenu de carte (6,6 em à 320 et 390 px texte 200 % ; ailleurs le
     nom tient à 93 % au plus), lettres à leur espacement normal, 16 px gagnés, le nom tient à 93 %. Pas plus large : à
     390 px texte 175 % (8,2 em), les lignes d'« Ilu — la monture aquatique des Metkayina » changeaient et trois
     finissaient de suite par un trait. */
  @container eywa-card (max-width: 7em) {
    .entry-card__title {
      letter-spacing: normal;
    }
  }

  .entry-card__summary {
    font-family: var(--font-body);
    /*
      Pinned to 14px (was 0.875rem = ~15.3px after the body bump) — cards
      are dense, 3-line clamp must hold across 24-entry grids (Bestiaire,
      Personnages). The contrast lift on --color-eywa-text-muted does the
      heavy lifting for readability here.
    */
    font-size: 0.8rem;
    color: var(--color-eywa-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Mouvement réduit : rien ne bouge, l'éveil reste lisible et les spores sont posées. */
  @media (prefers-reduced-motion: reduce) {
    .entry-card,
    .entry-card::before,
    .entry-card::after,
    .entry-card__img,
    .entry-card__fallback,
    .entry-card__title,
    .entry-card__media::after {
      transition: none !important;
    }
    .entry-card,
    .entry-card::before,
    .entry-card::after,
    .entry-card__spore,
    .entry-card.is-blooming {
      animation: none !important;
    }
    .entry-card:is(:hover, :focus-visible, .is-awake, .is-blooming) {
      transform: none !important;
    }
    .entry-card:is(:hover, :focus-visible, .is-awake, .is-blooming) :is(.entry-card__img, .entry-card__fallback) {
      transform: none !important;
    }
    .entry-card:is(:focus-visible, .is-awake, :hover:not(.is-touched)) .entry-card__spore {
      opacity: 0.8;
      bottom: var(--y);
    }
  }
</style>

<script is:inline data-entry-card-tap>
  /*
    Tap-friendly bloom on .entry-card. On devices without hover
    (mobile/tablet — `(hover: none)`), a tap paints .is-blooming for 200 ms.
    The click is NOT intercepted : the ClientRouter navigates at once,
    without reload (L30 — it used to wait 1.5 s then reload the page). Honors:
      - prefers-reduced-motion → no bloom
      - middle/cmd/ctrl/shift click → no bloom (new tab / new window)
    One listener on `document`, set once : it survives ClientRouter swaps.
  */
  (() => {
    if (typeof window === 'undefined') return;
    if (window.__eywaEntryCardTapInit) return;
    window.__eywaEntryCardTapInit = true;

    const BLOOM_MS = 200;
    const wantsBloom = () => window.matchMedia('(hover: none)').matches;
    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.addEventListener(
      'click',
      (e) => {
        const card =
          e.target instanceof Element ? e.target.closest('a.entry-card') : null;
        if (!card) return;
        if (!wantsBloom()) return;
        if (reducedMotion()) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (e.button !== undefined && e.button !== 0) return;

        // Restart the animation if the card is tapped again.
        card.classList.remove('is-blooming');
        void card.offsetWidth;
        card.classList.add('is-blooming');
        window.setTimeout(() => card.classList.remove('is-blooming'), BLOOM_MS);
      },
      // Capture phase so the bloom is painted before the router swaps the page.
      true
    );

    /*
      Éveil au toucher (L33) : un doigt ou un stylet posé sur une carte l'éveille
      (.is-awake : liseré qui pulse, image éclairée, spores), une seule à la fois ;
      elle se rendort AWAKE_MS après que le doigt s'est levé ou que le défilement a
      repris la main (pointercancel). Rien n'est intercepté : le toucher navigue
      comme avant. La souris éveille par :hover, le clavier par :focus-visible (CSS).
    */
    const AWAKE_MS = 1400;
    let awake = null;
    let sleepTimer = 0;
    const sleep = () => {
      window.clearTimeout(sleepTimer);
      if (awake) awake.classList.remove('is-awake');
      awake = null;
    };
    document.addEventListener(
      'pointerdown',
      (e) => {
        if (e.pointerType === 'mouse') return;
        const card =
          e.target instanceof Element ? e.target.closest('a.entry-card') : null;
        if (!card) return;
        card.classList.add('is-touched');
        if (awake !== card) sleep();
        window.clearTimeout(sleepTimer);
        awake = card;
        card.classList.add('is-awake');
      },
      { passive: true }
    );
    const later = () => {
      if (!awake) return;
      window.clearTimeout(sleepTimer);
      sleepTimer = window.setTimeout(sleep, AWAKE_MS);
    };
    // Une vraie souris rend au survol CSS la carte touchée auparavant (écran tactile + souris).
    document.addEventListener(
      'pointerover',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        const card =
          e.target instanceof Element ? e.target.closest('a.entry-card.is-touched') : null;
        if (card) card.classList.remove('is-touched');
      },
      { passive: true }
    );
    document.addEventListener('pointerup', later, { passive: true });
    document.addEventListener('pointercancel', later, { passive: true });
    // La page change sous le ClientRouter : la carte éveillée n'existe plus.
    document.addEventListener('astro:before-swap', sleep);
  })();
</script>
