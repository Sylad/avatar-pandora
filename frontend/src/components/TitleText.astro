---
/**
 * Texte d'un titre avec ses coupures (L73) : U+00AD de titleBreaks, et chaque mot qui en porte dans une boîte
 * `.title-word` (inline-block, `hyphens: manual`, global.css) — il passe entier à la ligne et ne se coupe que s'il est
 * plus large qu'une ligne. Le titre qui l'emploie porte `aria-label={text}` : son nom accessible reste sans U+00AD, et
 * le texte copié en est purgé (lib/soft-hyphen-copy.ts). `section` : titre d'une section du codex, repli à 2 lettres
 * permis pour un mot qui n'a aucune coupure à 3 lettres. `lang="en"` : titre anglais, coupé à la seule table anglaise
 * (EN_EXCEPTIONS), le titre (ou un parent) porte lui-même `lang="en"`.
 *
 * `dual` (L74, titres des fiches du codex) : le texte d'origine (`.title-plain`) et sa version en boîtes
 * (`.title-boxed`), l'une ou l'autre affichée selon le gabarit (global.css, seuil de 17,5 em). Les boîtes ne servent
 * que dans un gabarit étroit pour son texte ; ailleurs, même en `display: contents`, elles changeaient l'arrondi d'une
 * ligne pleine au pixel près (« Iknimaya — Le chemin vers le ciel », 499 px pour 499, passait sur deux lignes à 1024 px).
 * Copie (L79) : seule la version affichée va dans le HTML du presse-papier (lib/soft-hyphen-copy.ts, `cloneShown`).
 */
import { titleSegments, type SegmentOptions } from '../lib/title-breaks';

interface Props {
  text: string;
  section?: boolean;
  lang?: SegmentOptions['lang'];
  dual?: boolean;
}
const { text, section = false, lang, dual = false } = Astro.props;
const segments = titleSegments(text, { lang, ...(section ? { fallbackBefore: 2 } : {}) });
const boxed = segments.some((s) => s.word);
---
{dual && boxed
  ? <Fragment><span class="title-plain">{text}</span><span class="title-boxed">{segments.map((s) => (s.word ? <span class="title-word">{s.text}</span> : s.text))}</span></Fragment>
  : dual ? text : segments.map((s) => (s.word ? <span class="title-word">{s.text}</span> : s.text))}
