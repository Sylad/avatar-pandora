---
/*
  Bandeau d'image en tête d'une fiche du codex (format 21:9). Image hébergée
  → cliquable en plein écran (visionneuse) ; sinon visuel par défaut, sans
  requête réseau ni trou (L16, proxy Fandom retiré).
*/
import CoverFallback from './CoverFallback.astro';
import { coverImageSrc } from '../lib/cover';

interface Props {
  cover?: string;
  title: string;
  /** Nom de la section, affiché dans le visuel par défaut. */
  section: string;
}
const { cover, title, section } = Astro.props;
const src = coverImageSrc(cover);
---
{src ? (
  <div class="relative aspect-[21/9] rounded-md overflow-hidden mb-12 border border-eywa-text-muted/20" data-lightbox>
    <img src={src} alt={title} class="w-full h-full object-cover" />
  </div>
) : (
  <div class="relative aspect-[21/9] rounded-md overflow-hidden mb-12 border border-eywa-text-muted/20">
    <CoverFallback label={section} size={150} />
  </div>
)}
