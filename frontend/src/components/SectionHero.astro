---
/**
 * Hero banner pour les section indexes du codex.
 * Image grand format (21:9 cinéma) avec titre + sous-titre + tagline
 * en overlay sur un dégradé qui s'éteint vers le bas pour la lisibilité.
 * Donne à chaque section un punch visuel "magazine cover" avant la grille
 * de cards.
 */
interface Props {
  roman: string;
  label: string;
  title: string;
  tagline: string;
  cover?: string;
  /** Ikrans qui traversent le bandeau de temps en temps (L34) : Pandora et Bestiaire. */
  ikrans?: boolean;
}
import IkranSky from './IkranSky.astro';
import CoverFallback from './CoverFallback.astro';
import { coverImageSrc, isIllustration, ILLUSTRATION_SIZES } from '../lib/cover';
import SkySpots from './SkySpots.astro';

const { roman, label, title, tagline, cover, ikrans = false } = Astro.props;

// Image hébergée par le site, sinon visuel par défaut (proxy Fandom retiré, L16).
const imgSrc = coverImageSrc(cover);
const size = isIllustration(cover) ? ILLUSTRATION_SIZES.fiche : undefined;
---
<header class="section-hero">
  {imgSrc
    ? <img src={imgSrc} alt="" width={size?.width} height={size?.height} class="section-hero__img" />
    : <CoverFallback mark={false} />}
  <!--
    Jour et nuit (L35, prototype du 10-10) : l'heure du visiteur règle ces calques par les variables
    --sky-* posées sur <html> (lib/day-night.ts). Voile noir (luminosité), teinte bleu nuit, lueur du
    crépuscule, la forêt elle-même qui s'illumine (copie de l'image en lueur cyan, surtout en bas) et
    des points bioluminescents. Tous sous le voile de lecture : le texte garde son contraste.
  -->
  <div class="sky" aria-hidden="true">
    <div class="sky__shade"></div>
    <div class="sky__tint"></div>
    <div class="sky__dusk"></div>
    {imgSrc && <img src={imgSrc} alt="" width={size?.width} height={size?.height} class="sky__glow" decoding="async" />}
    <SkySpots class="sky__spots" />
  </div>
  {ikrans && <IkranSky />}
  <div class="section-hero__veil"></div>
  <div class="section-hero__content">
    <p class="section-hero__roman">{roman} — {label}</p>
    <h1 class="section-hero__title">{title}</h1>
    <p class="section-hero__tagline">{tagline}</p>
  </div>
</header>

<style>
  .section-hero {
    position: relative;
    /* Minimum : 16:10 sur téléphone (lisible), 21:9 dès 768 px (cinéma). */
    /* Le texte est dans le flux : le bandeau grandit avec lui au lieu de
       le rogner (WCAG 1.4.10). Le 16:10 n'est qu'un minimum, tenu par ::before
       (aspect-ratio ne le ferait pas : overflow: hidden annule la taille minimale
       automatique). */
    display: flex;
    align-items: flex-end;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid rgba(232, 230, 221, 0.1);
    box-shadow:
      0 0 0 1px rgba(95, 255, 230, 0.06) inset,
      0 0 30px -8px rgba(95, 255, 230, 0.20);
  }
  .section-hero::before {
    content: '';
    flex: none;
    width: 0;
    padding-top: 62.5%;
  }
  @media (min-width: 768px) {
    .section-hero::before {
      padding-top: 42.857%;
    }
  }

  .section-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05);
    /*
      "Living hero" — two decoupled cycles on different durations so the
      combined motion feels organic, not periodic.
       - Ken Burns : slow pan + zoom (20s, alternate)
       - Breath : bioluminescent brightness/saturation breathing (7s, alternate)
      Slight will-change hint for smoother compositing on low-end GPUs.
    */
    transform-origin: 55% 45%;
    will-change: transform, filter;
    animation:
      hero-kenburns 20s ease-in-out infinite alternate,
      hero-breath 7s ease-in-out infinite alternate;
  }

  /* ---------- Jour et nuit (L35) ---------- */
  .sky,
  .sky > :global(*) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sky__shade {
    background: #000;
    opacity: var(--sky-shade, 0);
  }
  .sky__tint {
    background: linear-gradient(180deg, #0b1450 0%, #1a1f6e 55%, #10164a 100%);
    mix-blend-mode: multiply;
    opacity: var(--sky-tint, 0);
  }
  .sky__dusk {
    background: linear-gradient(180deg, rgba(255, 140, 60, 0.55), rgba(255, 93, 196, 0.25) 60%, transparent);
    mix-blend-mode: soft-light;
    opacity: var(--sky-dusk, 0);
  }
  /* La forêt qui s'illumine : même cadrage et même lent travelling que l'image. */
  .sky__glow {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(2.4) brightness(0.62) sepia(1) hue-rotate(125deg) saturate(5);
    mix-blend-mode: screen;
    opacity: var(--sky-glow, 0);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.25) 22%, #000 55%);
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.25) 22%, #000 55%);
    transform-origin: 55% 45%;
    animation: hero-kenburns 20s ease-in-out infinite alternate;
  }
  /* De jour, rien de tout cela n'est dessiné (ni composé). */
  :global(html:not([data-sky-lit])) .sky__glow { visibility: hidden; }

  /*
    Multi-stop veil : bottom-left dark for the title overlay readability,
    overall slight cyan tint for the bioluminescent feel, top-right
    lighter so the image still breathes. Also pulses very slightly to give
    the impression of light shifting through Pandora's canopy.
  */
  .section-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg,
        rgba(10, 10, 31, 0.70) 0%,
        rgba(10, 10, 31, 0.30) 35%,
        rgba(10, 10, 31, 0.10) 70%),
      linear-gradient(to top,
        rgba(10, 10, 31, 0.85) 0%,
        rgba(10, 10, 31, 0.20) 50%,
        transparent 100%);
    animation: hero-veil-pulse 11s ease-in-out infinite alternate;
  }
  /* Téléphone (L35) : le texte couvre presque tout le bandeau 16:10, jusque dans le haut clair
     de l'image ; de jour, le sur-titre et l'accroche tombaient à 3,8:1. Un voile uniforme en plus
     tient 4,5:1 au pire pixel dans les deux ambiances (scripts/day-night.e2e.test.mjs). */
  @media (max-width: 767px) {
    .section-hero__veil {
      background:
        linear-gradient(rgba(10, 10, 31, 0.42), rgba(10, 10, 31, 0.42)),
        linear-gradient(135deg,
          rgba(10, 10, 31, 0.70) 0%,
          rgba(10, 10, 31, 0.30) 35%,
          rgba(10, 10, 31, 0.10) 70%),
        linear-gradient(to top,
          rgba(10, 10, 31, 0.85) 0%,
          rgba(10, 10, 31, 0.20) 50%,
          transparent 100%);
    }
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.06) translate3d(-1.2%, -1.5%, 0);
    }
  }

  @keyframes hero-breath {
    from {
      filter: saturate(1.05) brightness(1);
    }
    to {
      filter: saturate(1.18) brightness(1.08);
    }
  }

  @keyframes hero-veil-pulse {
    from { opacity: 1; }
    to   { opacity: 0.95; }
  }

  /* Accessibility — respect prefers-reduced-motion strictly. */
  @media (prefers-reduced-motion: reduce) {
    .section-hero__img,
    .section-hero__veil,
    .sky__glow {
      animation: none;
    }
    .sky__glow { transform: none; }
    .section-hero__img {
      transform: none;
      filter: saturate(1.05);
    }
  }

  .section-hero__content {
    position: relative;
    width: 100%;
    padding: 1.25rem 1.25rem 1.1rem;
    /* Conteneur du titre (L70) : sa taille suit aussi la largeur du bandeau. */
    container-type: inline-size;
  }
  @media (min-width: 768px) {
    .section-hero__content {
      padding: 2.5rem 2.5rem 2rem;
    }
  }

  .section-hero__roman {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-eywa-bio-primary);
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 6px rgba(10, 10, 31, 0.85);
  }

  /* Taille plafonnée par la largeur du bandeau (L70, WCAG 1.4.4) : à 14cqi, le plus long mot d'un titre de
     section (« technologie », 6,9 em) tient sur sa ligne même quand le texte agrandi dépasse le bandeau
     (« Pandora » se cassait à 390 px texte 175 %, à 1440 px texte 175 % avec la barre latérale). Au réglage
     normal, 14cqi dépasse toujours la taille fixée : rien ne change. */
  .section-hero__title {
    font-family: var(--font-display);
    font-size: min(1.85rem, 14cqi);
    line-height: 1.05;
    color: var(--color-eywa-text);
    text-shadow:
      0 2px 12px rgba(10, 10, 31, 0.95),
      0 0 30px rgba(95, 255, 230, 0.20);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .section-hero__title {
      font-size: min(2.75rem, 14cqi);
    }
  }

  @media (min-width: 768px) {
    .section-hero__title {
      font-size: min(3.5rem, 14cqi);
    }
  }

  .section-hero__tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.125rem;
    /* Couleur pleine (L35) : un texte translucide prend la couleur de l'image dessous, de jour
       comme de nuit ; plein, son contraste se mesure au pire pixel (≈ l'ancien 85 % sur le voile). */
    color: #d6d4cc;
    text-shadow: 0 2px 6px rgba(10, 10, 31, 0.85);
    max-width: 40rem;
  }
</style>
