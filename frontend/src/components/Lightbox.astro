---
/*
  Lightbox plein écran — vanilla, ~80 lignes JS, zero dep.

  Usage : tout `<img>` à l'intérieur d'un wrapper `[data-lightbox]` (ou portant
  directement l'attribut `data-lightbox`) déclenche l'overlay au clic.
  L'overlay se ferme via Esc, clic en dehors de l'image, ou bouton ✕.

  À inclure une fois dans BaseLayout.astro pour couvrir toutes les pages.
*/
---

<dialog id="eywa-lightbox" class="eywa-lightbox" aria-label="Image en plein écran">
  <button type="button" class="eywa-lightbox__close" aria-label="Fermer">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <figure class="eywa-lightbox__figure">
    <!-- Cadre qui défile horizontalement au téléphone pour les captures de bureau
         (mode .is-pan, L14) ; sans effet sinon. -->
    <div class="eywa-lightbox__scroller">
      <img class="eywa-lightbox__img" alt="" hidden />
    </div>
    <p class="eywa-lightbox__hint" aria-hidden="true">Glisse pour parcourir →</p>
    <figcaption class="eywa-lightbox__caption"></figcaption>
  </figure>
</dialog>

<script is:inline>
  // Navigation par ClientRouter : ce script identique sur toutes les pages ne s'exécute
  // qu'au premier chargement, alors que le <dialog> est remplacé à chaque page. Les
  // écouteurs sont donc posés UNE fois sur document et retrouvent la visionneuse de la
  // page courante à chaque événement (L14 : elle ne s'ouvrait plus après une navigation).
  (() => {
    if (typeof window === 'undefined' || window.__eywaLightboxInit) return;
    window.__eywaLightboxInit = true;

    const parts = () => {
      const dialog = document.getElementById('eywa-lightbox');
      if (!dialog) return null;
      const img = dialog.querySelector('.eywa-lightbox__img');
      const cap = dialog.querySelector('.eywa-lightbox__caption');
      if (!img || !cap) return null;
      return { dialog, img, cap };
    };

    // Heuristique : on capture les <img> dans tout wrapper data-lightbox,
    // OU les <img data-lightbox>, OU le lien qui enveloppe une image dans un
    // wrapper data-lightbox. On exclut <img> dans la sidebar/burger/logo.
    const matchTarget = (el) => {
      if (!(el instanceof Element)) return null;
      // Ignore burger/logo SVG icons
      if (el.closest('#eywa-burger, .eywa-burger')) return null;
      if (el.closest('aside.eywa-sidebar, #eywa-sidebar')) return null;
      // Direct match
      if (el.tagName === 'IMG' && el.closest('[data-lightbox]')) return el;
      if (el.tagName === 'IMG' && el.hasAttribute('data-lightbox')) return el;
      // Lien qui enveloppe l'image (captures des Nouveautés) : Entrée au clavier
      // déclenche un clic dont la cible est le lien, pas l'image (L14).
      const link = el.closest('a');
      if (link && link.closest('[data-lightbox]')) {
        const inner = link.querySelector('img');
        if (inner) return inner;
      }
      return null;
    };

    // Closed lightbox : the <img> has no src and stays `hidden` (no empty
    // image left in the accessibility tree of every page).
    // Au téléphone (< 640 px), une image plus large que 1,5 écran (capture de bureau)
    // serait réduite au point d'être illisible : elle s'affiche à la hauteur disponible
    // dans un cadre qui défile horizontalement (revue UX L14). Sinon, image entière.
    const PAN_MAX_WIDTH = 640;
    const PAN_RATIO = 1.5;
    const open = (src, alt, natural) => {
      const p = parts();
      if (!p) return false;
      const { dialog, img, cap } = p;
      const scroller = dialog.querySelector('.eywa-lightbox__scroller');
      const pan = !!natural && natural.w > 0 && window.innerWidth < PAN_MAX_WIDTH && natural.w > PAN_RATIO * window.innerWidth;
      dialog.classList.toggle('is-pan', pan);
      if (scroller) {
        if (pan) {
          scroller.setAttribute('tabindex', '0');
          scroller.setAttribute('role', 'region');
          scroller.setAttribute('aria-label', 'Image agrandie : glisse ou utilise les flèches pour parcourir');
          scroller.scrollLeft = 0;
        } else {
          scroller.removeAttribute('tabindex');
          scroller.removeAttribute('role');
          scroller.removeAttribute('aria-label');
        }
      }
      img.style.setProperty('--nat-h', natural && natural.h ? `${natural.h}px` : 'none');
      img.setAttribute('src', src);
      img.hidden = false;
      img.setAttribute('alt', alt || '');
      cap.textContent = alt || '';
      cap.style.display = alt ? '' : 'none';
      // Use native <dialog> when possible, fallback to manual class
      if (typeof dialog.showModal === 'function' && !dialog.open) {
        try { dialog.showModal(); } catch (_) { dialog.setAttribute('open', ''); }
      } else {
        dialog.setAttribute('open', '');
      }
      document.documentElement.classList.add('eywa-lightbox-open');
      return true;
    };
    const close = () => {
      const p = parts();
      if (p) {
        const { dialog, img } = p;
        if (typeof dialog.close === 'function' && dialog.open) {
          try { dialog.close(); } catch (_) { dialog.removeAttribute('open'); }
        } else {
          dialog.removeAttribute('open');
        }
        img.removeAttribute('src');
        img.hidden = true;
      }
      document.documentElement.classList.remove('eywa-lightbox-open');
    };
    const isOpen = () => !!parts()?.dialog.hasAttribute('open');

    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      if (el.closest('.eywa-lightbox__close')) { e.stopPropagation(); close(); return; }
      // Backdrop click (target === dialog itself, not figure) closes.
      if (el.id === 'eywa-lightbox') { close(); return; }
      const target = matchTarget(el);
      if (!target) return;
      const src = target.currentSrc || target.src;
      if (!src) return;
      const natural = { w: target.naturalWidth || +target.getAttribute('width') || 0, h: target.naturalHeight || +target.getAttribute('height') || 0 };
      if (open(src, target.alt || '', natural)) e.preventDefault();
    });
    // « cancel » ne remonte pas : écouté en phase de capture.
    document.addEventListener('cancel', (e) => {
      if (e.target instanceof Element && e.target.id === 'eywa-lightbox') { e.preventDefault(); close(); }
    }, true);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    // Page quittée visionneuse ouverte (retour arrière) : pas de défilement bloqué.
    document.addEventListener('astro:after-swap', () => {
      document.documentElement.classList.remove('eywa-lightbox-open');
    });
  })();
</script>

<style is:global>
  /* Lock scroll on body when lightbox is open. */
  html.eywa-lightbox-open,
  html.eywa-lightbox-open body {
    overflow: hidden;
  }

  .eywa-lightbox {
    /* Reset native <dialog> defaults. */
    border: 0;
    padding: 0;
    margin: 0;
    background: transparent;
    color: inherit;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
  }
  .eywa-lightbox::backdrop {
    background: rgba(2, 6, 14, 0.92);
    backdrop-filter: blur(4px);
  }
  /* When <dialog> isn't supported and we use the [open] attribute fallback. */
  .eywa-lightbox:not([open]) {
    display: none;
  }
  .eywa-lightbox[open] {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 200;
    align-items: center;
    justify-content: center;
    background: rgba(2, 6, 14, 0.92);
  }
  .eywa-lightbox__figure {
    margin: 0;
    max-width: min(96vw, 1600px);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    /* Faint cyan border to keep the Eywa identity. */
    box-shadow: 0 0 60px -12px rgba(95, 255, 230, 0.45);
    border-radius: 6px;
    overflow: hidden;
  }
  .eywa-lightbox__img {
    display: block;
    max-width: 100%;
    max-height: calc(92vh - 2.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    background: #0a0a1f;
  }
  .eywa-lightbox__caption {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: rgba(232, 230, 221, 0.78);
    text-align: center;
    padding: 0.5rem 1rem;
    margin: 0;
    background: rgba(8, 12, 22, 0.85);
    width: 100%;
  }
  .eywa-lightbox__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 210;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(95, 255, 230, 0.45);
    background: rgba(8, 12, 22, 0.85);
    color: #5fffe6;
    cursor: pointer;
    backdrop-filter: blur(6px);
    box-shadow: 0 0 18px -6px rgba(95, 255, 230, 0.55);
    transition: transform 150ms ease, box-shadow 200ms ease;
  }
  .eywa-lightbox__close:hover {
    transform: scale(1.05);
    box-shadow: 0 0 28px -4px rgba(95, 255, 230, 0.75);
  }
  .eywa-lightbox__close:active { transform: scale(0.95); }
  .eywa-lightbox__close svg { width: 1.5rem; height: 1.5rem; }

  .eywa-lightbox__hint {
    display: none;
  }
  /* Mode défilement (téléphone, capture de bureau) : image à la hauteur disponible,
     sans dépasser sa taille réelle, dans un cadre qui défile horizontalement.
     « Fermer » reste fixe en haut à droite, hors du cadre. */
  .eywa-lightbox.is-pan .eywa-lightbox__figure {
    max-width: 100vw;
    width: 100vw;
    max-height: none;
    padding-top: 4rem;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
  }
  .eywa-lightbox.is-pan .eywa-lightbox__scroller {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    outline: none;
    box-shadow: 0 0 40px -12px rgba(95, 255, 230, 0.45);
  }
  .eywa-lightbox.is-pan .eywa-lightbox__scroller:focus-visible {
    outline: 2px solid #5fffe6;
    outline-offset: -2px;
  }
  .eywa-lightbox.is-pan .eywa-lightbox__img {
    max-width: none;
    width: auto;
    height: min(var(--nat-h, 100dvh), calc(100dvh - 9.5rem));
    max-height: none;
  }
  .eywa-lightbox.is-pan .eywa-lightbox__hint {
    display: block;
    margin: 0;
    font-family: var(--font-display, sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5fffe6;
    text-align: center;
  }

  /* Make <img> inside [data-lightbox] feel clickable. */
  [data-lightbox] img,
  img[data-lightbox] {
    cursor: zoom-in;
  }
</style>
