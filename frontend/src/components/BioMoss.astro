---
/*
  Lumière au toucher (L32, « Pandora vivant 1 », prototype validé par Sylvain le 10-10) :
  le fond de l'accueil et du codex s'allume sous le doigt ou la souris — des taches de
  mousse bioluminescente s'étendent puis s'éteignent (logique : lib/bio-moss.ts).

  • Au repos : quelques taches très faibles, posées une fois (image fixe, aucune animation).
  • Souris : une tache tous les 70 px parcourus (3 s) ; clic ou toucher : une tache plus grande,
    plus vive et plus longue (4,2 s). Au doigt, seul un toucher bref et immobile allume : un
    glissement (défilement) n'allume rien (pointerup, revue UX L32 m1).
  • Ni texte ni menu sur la mousse (revue UX L32, B1 et M1) : le calque est AU-DESSUS du fond des
    cartes (sinon, au téléphone, la fiche opaque la cachait sous le doigt), mais chaque tache porte
    un masque qui l'efface sous chaque ligne de texte, image, contrôle et sous le menu du codex
    (bande entière de la barre latérale ≥ 1024 px). Barre du haut, tiroir, menu et pause fixes
    restent au-dessus d'elle. Contrôlé par scripts/bio-moss.e2e.test.mjs (contraste au pire pixel).
  • Le calque couvre le document (repère de la page) : les masques, calculés une fois par mise en
    page, restent justes au défilement ; rien n'écoute le défilement.
  • Chaque tache est animée par Web Animations sur transform et opacity seulement, retirée à son
    extinction (minuterie). Pas de canvas : il bloquait la page 85 s en Chromium sans tête.
  • Pause de l'ambiance (AtmospherePause) : plus aucune tache, la mousse au repos reste.
  • Mouvement réduit : rien n'est posé.
*/
interface Props {
  /** Accueil : <main> est en z-index 10 (au codex : 2). */
  landing?: boolean;
}
const { landing = false } = Astro.props;
---

<div id="eywa-moss" class:list={['eywa-moss', { 'eywa-moss--landing': landing }]} aria-hidden="true"></div>

<script>
  import { ATMOSPHERE_EVENT, ATMOSPHERE_PAUSED_CLASS } from './cinema/atmosphere-clock';
  import {
    MOSS_LIFE_MS, MOSS_MAX, MOSS_TAP_LIFE_MS, isTap, mossKeyframes, mossSprite, seededRandom, shieldMask,
    shouldSpawn, type Box, type MossStep, type Rgb,
  } from '../lib/bio-moss';

  /** Relevés pour les tests : taches allumées en tout, temps passé à les poser, boîtes protégées. */
  interface MossStats { spawned: number; spawnMs: number; shields: number; collectMs: number; layoutMs: number }
  const w = window as Window & { __eywaMossInit?: boolean; __eywaMoss?: MossStats };

  // ClientRouter : ce module ne s'exécute qu'une fois ; le calque est retrouvé à chaque page.
  if (!w.__eywaMossInit) {
    w.__eywaMossInit = true;
    const stats: MossStats = (w.__eywaMoss = { spawned: 0, spawnMs: 0, shields: 0, collectMs: 0, layoutMs: 0 });
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const COLORS: Rgb[] = [
      [95, 255, 230], // cyan bio
      [127, 255, 143], // vert sacré
      [95, 255, 230],
      [255, 93, 196], // touche magenta, plus rare
    ];
    // Contenu à protéger : texte des racines, boîtes des éléments (images, contrôles…).
    const TEXT_ROOTS = 'main, .eywa-sidebar';
    const BOXES = 'img, picture, video, svg, canvas, iframe, button, input, select, textarea, [role="button"], [data-moss-shield]';
    let sprites: string[] = [];
    let tapSprites: string[] = [];
    let host: HTMLElement | null = null;
    let last: MossStep | null = null;
    let touch: (MossStep & { id: number }) | null = null;
    let shields: Box[] | null = null;
    let rest: { fx: number; fy: number; R: number; el: HTMLElement }[] = [];
    let relayout = 0;
    const live: HTMLElement[] = [];

    const paused = () => document.documentElement.classList.contains(ATMOSPHERE_PAUSED_CLASS);
    const phone = () => window.innerWidth < 768;

    // ── Boîtes protégées, dans le repère du calque (document entier) ──
    const visible = (el: Element, seen: Map<Element, boolean>) => {
      let v = seen.get(el);
      if (v === undefined) {
        const s = getComputedStyle(el);
        seen.set(el, (v = s.visibility !== 'hidden' && Number(s.opacity) > 0));
      }
      return v;
    };
    const opaqueColor = (c: string) => !/^rgba\(.*,\s*0\)$|^transparent$/.test(c);
    const collect = (): Box[] => {
      if (!host) return [];
      const t0 = performance.now();
      const o = host.getBoundingClientRect();
      const out: Box[] = [];
      const add = (r: DOMRect, line = 0) => {
        if (r.width <= 0 || r.height <= 0) return;
        // Ligne de texte : toute la hauteur de l'interligne, sinon le fondu laissait une couture claire
        // entre deux lignes d'un même paragraphe (D-6).
        const grow = Math.max(0, line - r.height) / 2;
        out.push({ x: r.left - o.left, y: r.top - o.top - grow, w: r.width, h: r.height + 2 * grow });
      };
      const lineHeights = new Map<Element, number>();
      const lineHeight = (el: Element) => {
        let v = lineHeights.get(el);
        if (v === undefined) lineHeights.set(el, (v = parseFloat(getComputedStyle(el).lineHeight) || 0)); // « normal » : 0
        return v;
      };
      const range = document.createRange();
      const seen = new Map<Element, boolean>();
      for (const root of document.querySelectorAll<HTMLElement>(TEXT_ROOTS)) {
        // Barre latérale du bureau (collante, translucide) : toute sa bande, du haut au bas de la page.
        if (root.matches('.eywa-sidebar')) {
          if (getComputedStyle(root).position !== 'sticky') continue; // tiroir : au-dessus du calque
          const r = root.getBoundingClientRect();
          out.push({ x: r.left - o.left, y: 0, w: r.width, h: host.offsetHeight });
          continue;
        }
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        while (walker.nextNode()) {
          const n = walker.currentNode;
          if (!n.textContent?.trim() || !n.parentElement || !visible(n.parentElement, seen)) continue;
          range.selectNodeContents(n);
          const line = lineHeight(n.parentElement);
          for (const r of range.getClientRects()) add(r, line);
        }
        for (const el of root.querySelectorAll(BOXES)) if (visible(el, seen)) add(el.getBoundingClientRect());
        // Lien ou contrôle dessiné (bordure ou fond) : sa boîte entière (WCAG 1.4.11).
        for (const el of root.querySelectorAll('a')) {
          const s = getComputedStyle(el);
          if (parseFloat(s.borderTopWidth) > 0 || opaqueColor(s.backgroundColor)) add(el.getBoundingClientRect());
        }
      }
      stats.shields = out.length;
      stats.collectMs += performance.now() - t0;
      return out;
    };
    const getShields = () => (shields ??= collect());

    const blot = (sprite: string, cls: string, cell: Box, mask = true) => {
      const wrap = document.createElement('div');
      wrap.className = 'eywa-moss__cell';
      Object.assign(wrap.style, { left: `${cell.x}px`, top: `${cell.y}px`, width: `${cell.w}px`, height: `${cell.h}px` });
      if (mask) masked(wrap, cell);
      const el = document.createElement('div');
      el.className = cls;
      el.style.backgroundImage = sprite;
      wrap.append(el);
      return { wrap, el };
    };
    /** Pose le masque de la tache ; `freeOnly` : seulement si elle n'en a pas besoin. Vrai si posé. */
    const masked = (wrap: HTMLElement, cell: Box, freeOnly = false) => {
      const svg = shieldMask(cell, getShields());
      if (svg && freeOnly) return false;
      const url = svg ? `url("data:image/svg+xml,${encodeURIComponent(svg)}")` : '';
      // Même masque : ne pas le réaffecter (chaque nouvelle image de masque est rastérisée).
      if (wrap.dataset.mask !== url) { wrap.dataset.mask = url; wrap.style.maskImage = url; }
      return true;
    };

    const remove = (wrap: HTMLElement) => {
      wrap.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      wrap.remove();
      const i = live.indexOf(wrap);
      if (i >= 0) live.splice(i, 1);
    };

    const spawn = (clientX: number, clientY: number, strength: number, life: number) => {
      if (!host || paused()) return;
      const t0 = performance.now();
      const o = host.getBoundingClientRect();
      // Toucher au téléphone : tache plus large que la colonne de texte, pour qu'elle déborde dans
      // les marges et entre les paragraphes autour du doigt (revue UX L32, M1).
      const base = life > MOSS_LIFE_MS ? (phone() ? 220 : 170) : phone() ? 95 : 130;
      const R = base * (0.85 + Math.random() * 0.3);
      const cell = { x: clientX - o.left - R, y: clientY - o.top - R, w: 2 * R, h: 2 * R };
      const set = life > MOSS_LIFE_MS ? tapSprites : sprites;
      const { wrap, el } = blot(set[Math.floor(Math.random() * set.length)], 'eywa-moss__patch', cell);
      host.append(wrap);
      live.push(wrap);
      el.animate(mossKeyframes(strength), { duration: life, easing: 'linear' });
      // Retirée à l'heure dite, même si la page n'a pas rendu d'image entre-temps (onglet caché).
      window.setTimeout(() => remove(wrap), life + 50);
      while (live.length > MOSS_MAX) remove(live[0]);
      stats.spawned++;
      stats.spawnMs += performance.now() - t0;
    };

    const clear = () => { while (live.length) remove(live[0]); };

    // Hauteur du calque = page entière ; masques de la mousse au repos recalculés.
    // `freeOnly` (chargement de la page) : seules les taches qui ne touchent rien de protégé sont
    // posées tout de suite ; celles qui demandent un masque attendent un moment libre (rastériser
    // ~20 masques coûtait ~200 ms de fil principal à chaque page, test R7 d'illustrations 5,6 → 17 s).
    const layout = (freeOnly = false) => {
      if (!host) return;
      const t0 = performance.now();
      host.style.height = `${Math.max(document.body.offsetHeight, window.innerHeight)}px`;
      shields = null;
      const W = host.offsetWidth, H = host.offsetHeight;
      for (const r of rest) {
        const cell = { x: r.fx * W - r.R, y: r.fy * H - r.R, w: 2 * r.R, h: 2 * r.R };
        if (!masked(r.el, cell, freeOnly)) { r.el.hidden = true; continue; } // jamais visible sans son masque
        Object.assign(r.el.style, { left: `${cell.x}px`, top: `${cell.y}px` });
        r.el.hidden = false;
      }
      stats.layoutMs += performance.now() - t0;
    };
    // Hors du chemin du chargement : la mousse au repos attend un moment libre du fil principal.
    const idle = (fn: () => void) =>
      ('requestIdleCallback' in window ? window.requestIdleCallback(fn, { timeout: 500 }) : window.setTimeout(fn, 200));
    const scheduleLayout = () => { clearTimeout(relayout); relayout = window.setTimeout(() => idle(() => layout()), 250); };
    const observer = new ResizeObserver(scheduleLayout);

    // Mousse au repos : même dessin à chaque visite, placé en part de la page.
    const mount = () => {
      clear();
      last = null;
      touch = null;
      rest = [];
      shields = null; // nouvelle page
      observer.disconnect();
      host = document.getElementById('eywa-moss');
      if (!host) return;
      host.replaceChildren();
      if (reduced.matches) { host = null; return; }
      if (!sprites.length) {
        const url = (svg: string) => `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
        sprites = COLORS.map((c, i) => url(mossSprite(10 + i, c)));
        tapSprites = COLORS.map((c, i) => url(mossSprite(20 + i, c, { spread: true })));
      }
      host.style.height = `${Math.max(document.body.offsetHeight, window.innerHeight)}px`;
      const screens = Math.min(2, host.offsetHeight / window.innerHeight);
      const rand = seededRandom(32);
      const n = Math.round((phone() ? 6 : 10) * screens);
      for (let i = 0; i < n; i++) {
        const R = (phone() ? 95 : 130) * (0.6 + rand() * 0.6);
        const r = { fx: rand(), fy: rand(), R };
        const { wrap } = blot(sprites[i % sprites.length], 'eywa-moss__rest', { x: 0, y: 0, w: 2 * R, h: 2 * R }, false);
        wrap.hidden = true;
        (wrap.firstElementChild as HTMLElement).style.opacity = (0.16 + rand() * 0.12).toFixed(2);
        host.append(wrap);
        rest.push({ ...r, el: wrap });
      }
      layout(true);
      idle(() => layout());
      observer.observe(document.body);
    };

    window.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return; // glisser du doigt = défiler
      const step = { x: e.clientX, y: e.clientY, t: e.timeStamp };
      // Premier mouvement vu : position notée seulement. Chromium envoie un faux pointermove quand la
      // page bouge sous un pointeur immobile (chargement) : il allumait une tache sans geste.
      if (!last) { last = step; return; }
      if (!shouldSpawn(last, step)) return;
      last = step;
      spawn(step.x, step.y, 0.75, MOSS_LIFE_MS);
    }, { passive: true });
    window.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') {
        touch = { id: e.pointerId, x: e.clientX, y: e.clientY, t: e.timeStamp };
        return;
      }
      spawn(e.clientX, e.clientY, 1, MOSS_TAP_LIFE_MS);
    }, { passive: true });
    // Toucher : allumé au lever du doigt, seulement s'il n'a ni glissé ni duré (sinon : défilement).
    window.addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'touch' || !touch || touch.id !== e.pointerId) return;
      const down = touch;
      touch = null;
      if (isTap(down, { x: e.clientX, y: e.clientY, t: e.timeStamp })) spawn(down.x, down.y, 1, MOSS_TAP_LIFE_MS);
    }, { passive: true });
    window.addEventListener('pointercancel', () => { touch = null; }, { passive: true });
    window.addEventListener('resize', scheduleLayout, { passive: true });
    // Image ou police chargée : la mise en page a pu bouger.
    document.addEventListener('load', scheduleLayout, { capture: true, passive: true });
    document.fonts?.addEventListener?.('loadingdone', scheduleLayout);
    window.addEventListener(ATMOSPHERE_EVENT, () => { if (paused()) clear(); });
    reduced.addEventListener('change', mount);
    document.addEventListener('astro:page-load', mount);
    mount();
  }
</script>

<style>
  /* Page entière (repère du document, hauteur posée par le script), AU-DESSUS du fond du contenu
     (<main> : z-index 2 au codex, 10 à l'accueil) mais masquée sous tout ce qui se lit ; sous la
     barre du haut (39), le voile et le tiroir (40, 50), le menu (60) et la pause (70). Un peu
     atténuée (0,65 tant qu'elle passait sous le texte ; masquée, elle peut être plus vive). */
  .eywa-moss {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 3;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.85;
  }
  .eywa-moss--landing { z-index: 11; }
  .eywa-moss :global(.eywa-moss__cell) {
    position: absolute;
    /* Masque en luminance (blanc = mousse visible, noir = effacée) : une image SVG serait lue en
       alpha par défaut, et le noir opaque laisserait la mousse sur le texte. */
    mask-mode: luminance;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
  .eywa-moss :global(.eywa-moss__rest),
  .eywa-moss :global(.eywa-moss__patch) {
    position: absolute;
    inset: 0;
    background-size: 100% 100%;
  }
  /* Avant sa première image clé, une tache est invisible (pas d'éclair au point touché). */
  .eywa-moss :global(.eywa-moss__patch) { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .eywa-moss { display: none; }
  }
</style>
