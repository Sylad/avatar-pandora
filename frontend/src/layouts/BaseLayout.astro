---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Lightbox from '../components/Lightbox.astro';
import AmbientAudio from '../components/AmbientAudio.astro';
import { BUILD_VERSION } from '../lib/build-version';
import news from '../../public/nouveautes-data/nouveautes.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Eywa', description = 'Codex de Pandora' } = Astro.props;

// Index léger des Nouveautés pour la pastille (slug + date seulement).
const newsIndex = JSON.stringify(
  (news as { entries: { slug: string; date: string }[] }).entries.map(({ slug, date }) => ({ slug, date })),
);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="version" content={BUILD_VERSION} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/cormorant-garamond/CormorantGaramond-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/orbitron/Orbitron-wght.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-eywa-bg text-eywa-text min-h-screen">
    <slot />
    <!-- Index léger (slug + date, jamais le texte) des Nouveautés, pour la pastille de tous
         les liens Nouveautés (components/NewsBadge.astro), accueil compris (L20). -->
    <script type="application/json" id="eywa-news-index" is:inline set:html={newsIndex}></script>
    <script>
      /*
        Pastille « Nouveautés » (L14, comme AetherWX ; L21 aligné sur evatosorus) — UN seul
        script pour tout le site, rejoué à chaque page (astro:page-load, ClientRouter) :
        • première page vue, quelle qu'elle soit : mémoire de base (rien n'est « nouveau »
          ce jour-là ; ce qui est publié ensuite l'est, même sans ouvrir /nouveautes/) ;
        • pastille sur TOUS les liens Nouveautés (.news-badge : menu, tiroir, accueil), point
          sur le bouton menu et nombre dans son nom accessible au repos ;
        • sur /nouveautes/ : bandeau « N nouveautés depuis ta dernière visite », marque
          « Nouveau », séparateur « Déjà vu lors de ta visite du … » HORS des listes (les
          entrées sont réparties en deux listes de part et d'autre d'un role="separator"),
          seulement si toutes les nouvelles sont au-dessus ; puis tout est marqué vu.
      */
      import {
        badgeLabel, countUnseen, ensureBaseline, isUnseen, markAllSeen, readSeen,
        seenSeparatorIndex, seenSeparatorLabel, sinceLabel, unseenLabel,
        type DatedEntry, type NewsSeen,
      } from '../lib/news-seen';

      const storage = () => {
        try { return window.localStorage; } catch { return null; }
      };

      // Page Nouveautés : marques, bandeau et séparateur selon la visite précédente `seen`.
      const showVisit = (seen: NewsSeen | null) => {
        const lists = [...document.querySelectorAll<HTMLOListElement>('ol.news-list')];
        if (!lists.length) return;
        // Rejoué sur la même page : une seule liste d'abord, sans séparateur.
        const list = lists[0];
        for (const extra of lists.slice(1)) { list.append(...extra.children); extra.remove(); }
        document.querySelectorAll('.news-seen-sep').forEach((n) => n.remove());

        const items = [...list.children] as HTMLLIElement[];
        const articles = items.map((li) => li.querySelector<HTMLElement>('article.news-entry')!);
        const fresh = articles.map((a) => isUnseen({ slug: a.id, date: a.querySelector('time')!.dateTime }, seen));
        articles.forEach((a, i) => {
          const slot = a.querySelector('.news-new-slot');
          if (!slot) return;
          slot.replaceChildren();
          if (fresh[i]) {
            const mark = document.createElement('span');
            mark.className = 'news-new';
            mark.textContent = 'Nouveau';
            slot.append(mark);
          }
        });
        const since = document.querySelector('.news-since');
        if (since) since.textContent = sinceLabel(fresh.filter(Boolean).length);

        const at = seen ? seenSeparatorIndex(fresh) : -1;
        if (at <= 0) return;
        const seenList = document.createElement('ol');
        // Mêmes classe et attribut de portée des styles Astro (data-astro-cid-…).
        for (const attr of [...list.attributes]) if (attr.name !== 'id') seenList.setAttribute(attr.name, attr.value);
        seenList.append(...items.slice(at));
        const sep = document.createElement('div');
        sep.className = 'news-seen-sep';
        sep.setAttribute('role', 'separator');
        const label = seenSeparatorLabel(seen!.at);
        sep.setAttribute('aria-label', label);
        const text = document.createElement('span');
        text.textContent = label;
        sep.append(text);
        list.after(sep, seenList);
      };

      const update = () => {
        let entries: DatedEntry[];
        try { entries = JSON.parse(document.getElementById('eywa-news-index')?.textContent ?? '[]'); } catch { return; }
        const st = storage();
        ensureBaseline(st, entries);
        let seen = readSeen(st);
        if (location.pathname.replace(/\/?$/, '/') === '/nouveautes/') {
          showVisit(seen);
          seen = markAllSeen(st, entries) ?? seen;
        }
        const n = countUnseen(entries, seen);
        const spoken = unseenLabel(n);
        document.querySelectorAll<HTMLElement>('.news-badge').forEach((badge) => {
          badge.hidden = n === 0;
          const digits = badge.querySelector('.news-badge__n');
          const sr = badge.querySelector('.news-badge__sr');
          if (digits) digits.textContent = badgeLabel(n);
          if (sr) sr.textContent = spoken ? `(${spoken})` : '';
        });
        const burger = document.getElementById('eywa-burger');
        const dot = burger?.querySelector<HTMLElement>('.eywa-burger__dot');
        if (dot) dot.hidden = n === 0;
        if (burger) {
          // L21 : le nombre est dans le nom du bouton (le point rose n'est qu'une forme) ;
          // le tiroir (CodexLayout) relit data-news-unseen à chaque fermeture.
          burger.dataset.newsUnseen = spoken;
          if (burger.getAttribute('aria-expanded') !== 'true') {
            burger.setAttribute('aria-label', spoken ? `Ouvrir la navigation (${spoken})` : 'Ouvrir la navigation');
          }
        }
      };

      document.addEventListener('astro:page-load', update);
    </script>
    <Lightbox />
    <AmbientAudio />
    <script is:inline>
      // Tap-friendly bioluminescence — global. On `(hover: none)` (touch),
      // pick 2-3 visible .bio-word at a time and pulse them on a ~4s cycle.
      // Works on landing tagline AND codex prose. IntersectionObserver tracks
      // visibility so we only pulse on-screen words. MutationObserver picks
      // up .bio-word spans created lazily by the per-page splitter scripts.
      (() => {
        if (typeof window === 'undefined') return;
        if (window.__eywaBioPulseInit) return;
        window.__eywaBioPulseInit = true;

        const hoverless = window.matchMedia('(hover: none)');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (reduced.matches) return;

        const PULSE_MS = 3400; // matches @keyframes bio-word-pulse duration
        const CYCLE_MS = 4200; // gap between cycles

        const visible = new Set();
        let intervalId = null;
        let observer = null;
        let mo = null;

        const pickAndPulse = () => {
          if (!visible.size) return;
          // Ambiance de l'accueil mise en pause (AtmospherePause) : pas de pulsation.
          if (document.documentElement.classList.contains('eywa-atmo-paused')) return;
          const arr = Array.from(visible).filter(
            (el) => el.isConnected && !el.classList.contains('is-pulsing')
          );
          if (!arr.length) return;
          const count = 2 + Math.floor(Math.random() * 2); // 2 or 3
          const picks = [];
          for (let i = 0; i < count && arr.length; i++) {
            const idx = Math.floor(Math.random() * arr.length);
            picks.push(arr.splice(idx, 1)[0]);
          }
          picks.forEach((el) => {
            const delay = Math.floor(Math.random() * 600);
            window.setTimeout(() => {
              if (!el.isConnected) return;
              el.classList.add('is-pulsing');
              window.setTimeout(
                () => el.classList.remove('is-pulsing'),
                PULSE_MS
              );
            }, delay);
          });
        };

        const observeAll = () => {
          if (!observer) return;
          document.querySelectorAll('.bio-word').forEach((el) => {
            observer.observe(el);
          });
        };

        const start = () => {
          if (intervalId !== null) return;
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) visible.add(entry.target);
                else visible.delete(entry.target);
              }
            },
            { rootMargin: '0px', threshold: 0.5 }
          );
          observeAll();
          mo = new MutationObserver(() => observeAll());
          mo.observe(document.body, { childList: true, subtree: true });

          intervalId = window.setInterval(pickAndPulse, CYCLE_MS);
          window.setTimeout(pickAndPulse, 800);
        };

        const stop = () => {
          if (intervalId !== null) {
            window.clearInterval(intervalId);
            intervalId = null;
          }
          if (observer) {
            observer.disconnect();
            observer = null;
          }
          if (mo) {
            mo.disconnect();
            mo = null;
          }
          visible.clear();
          document
            .querySelectorAll('.bio-word.is-pulsing')
            .forEach((el) => el.classList.remove('is-pulsing'));
        };

        const sync = () => {
          if (hoverless.matches) start();
          else stop();
        };
        sync();
        hoverless.addEventListener?.('change', sync);
        document.addEventListener('astro:page-load', () => {
          stop();
          sync();
        });
      })();
    </script>
  </body>
</html>
