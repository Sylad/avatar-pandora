---
import { getCollection } from 'astro:content';
import CodexLayout from '../layouts/CodexLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import SectionHero from '../components/SectionHero.astro';
import SectionCredit from '../components/SectionCredit.astro';

const entries = await getCollection('films');
entries.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---
<CodexLayout title="Les films — Eywa" current="films">
  <SectionHero
    roman="VII"
    label="Les films"
    title="Trois œuvres, vingt-cinq ans de Pandora"
    tagline="De 2009 à 2025 — l'évolution d'une vision."
    cover="/illustrations/films/avatar-2009.webp"
  />
  <section class="codex-grid">
    {entries.map((entry) => (
      <EntryCard href={`/films/${entry.id}/`} title={entry.data.title} summary={entry.data.summary} cover={entry.data.cover} />
    ))}
  </section>
  <SectionCredit entries={entries} label="Images officielles des films" />
</CodexLayout>
