---
import BaseLayout from '../layouts/BaseLayout.astro';
import FollowLinks from '../components/FollowLinks.astro';
import EywaLogo from '../components/EywaLogo.astro';
import TitleText from '../components/TitleText.astro';
import { addressParts } from '../lib/title-breaks';

const STACK = [
  {
    group: 'Frontend',
    items: [
      'Astro 6 (paradigme islands, statique-first)',
      'React 19 (îlots interactifs)',
      'TypeScript strict',
      'Tailwind CSS 4 (vite plugin + tokens @theme)',
      'Astro Content Collections (markdown + Zod)',
      'SVG inline pour le logo',
    ],
  },
  {
    group: 'Identité',
    items: [
      'Palette bioluminescente Pandora (cyan, magenta, vert sacré, ambre Fire & Ash)',
      'Typo Orbitron (display) + Cormorant Garamond (body)',
      'Logo SVG custom : EVA caché dans EYWA',
    ],
  },
  {
    group: 'Infra',
    items: [
      'Build statique Astro, servi par Cloudflare Pages (CDN mondial)',
      'Déploiement à chaque push sur main, livraison vérifiée par cadence deliver',
      'Polices auto-hébergées, CSP stricte, aucun appel à un service tiers',
    ],
  },
];

const SOURCES = [
  {
    name: 'Pandorapedia',
    by: 'Disney / 20th Century Studios',
    why: 'Source canonique officielle pour le lore Avatar — biomes, clans, créatures, technologies humaines.',
    url: 'https://www.pandorapedia.com/',
  },
  {
    name: 'Avatar Wiki (Fandom)',
    by: 'Communauté de fans',
    why: 'Couverture détaillée des personnages, scènes des films, et des évolutions de l\'univers entre les trois films.',
    url: 'https://james-camerons-avatar.fandom.com/',
  },
  {
    name: 'Travaux du Dr Paul Frommer',
    by: 'Paul Frommer (linguiste)',
    why: 'La langue Na\'vi est une vraie langue construite, avec grammaire et lexique. Source pour la section Langue.',
    url: 'https://naviteri.org/',
  },
  {
    name: 'refactoringui.com',
    // Mots du nom (« Refactoring UI ») : l'adresse passe à la ligne entre eux, jamais au milieu d'un mot (L78).
    words: ['refactoring', 'ui'],
    by: 'Adam Wathan & Steve Schoger',
    why: 'Le bouquin de chevet pour les non-designers : grille, contraste, hiérarchie, espacement.',
    url: 'https://refactoringui.com/',
  },
];
---
<BaseLayout title="À propos — Eywa" description="Le pourquoi d'Eywa, et un mot pour Eva.">
  <div class="about-frame">
  <main id="contenu" tabindex="-1" class="max-w-4xl mx-auto px-6 lg:px-8 py-16 lg:py-20 space-y-10">

    <header class="flex flex-col gap-2 mb-2">
      <p class="text-xs uppercase tracking-[0.22em] text-eywa-text-muted font-display font-semibold">
        À propos · Eywa
      </p>
      <h1 class="font-display text-3xl lg:text-4xl font-bold text-eywa-bio-primary" aria-label="Vibe coded avec Claude Code & Codex">
        <span lang="en"><TitleText text="Vibe coded" /></span> <TitleText text="avec Claude Code & Codex" />
      </h1>
      <p class="text-eywa-text-muted max-w-2xl font-body text-lg">
        Un codex visuel de Pandora — construit comme un cadeau, exécuté comme un labo.
      </p>
    </header>

    <section class="about-box relative overflow-hidden rounded-md border border-eywa-text-muted/20 bg-eywa-text/[0.02] p-6 lg:p-8">
      <div class="absolute -top-12 -right-12 w-64 h-64 rounded-full bg-eywa-bio-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-16 -left-12 w-64 h-64 rounded-full bg-eywa-bio-secondary/10 blur-3xl pointer-events-none"></div>
      <div class="relative flex flex-col sm:flex-row items-start gap-6">
        <div class="shrink-0">
          <EywaLogo size={140} />
        </div>
        <div class="flex-1 min-w-0 font-body text-eywa-text leading-relaxed space-y-4">
          <h2 class="font-display text-xl font-bold text-eywa-bio-primary mb-1" aria-label="L'histoire courte">
            <TitleText text="L'histoire courte" />
          </h2>
          <p>
            À Eva, fan absolue des grands bleus de Pandora. Moi je trouve ça moyen, mais bon —
            les goûts, les couleurs, et la bioluminescence.
          </p>
          <p>
            Le nom <strong class="text-eywa-bio-primary">Eywa</strong> est celui de la déesse-réseau
            de Pandora, la conscience planétaire qui relie toute vie sur la lune. Mais regarde le
            logo deux secondes : le <strong class="text-eywa-bio-primary">E</strong>, la moitié
            gauche du <strong class="text-eywa-bio-primary">W</strong> (qui dessine un V), et le
            <strong class="text-eywa-bio-primary">A</strong> — éclats cyan — recomposent
            <strong class="text-eywa-bio-primary">EVA</strong>. La déesse t'a emprunté trois
            lettres.
          </p>
          <p>
            Pour le reste, dev Java côté serveur depuis vingt-et-un ans, mais novice sur tout ce
            qui scintille en frontend moderne. J'avais envie d'un terrain de jeu où Pandora serait
            l'excuse pour explorer Astro, le WebGL et les animations qui pulsent. Cadeau et labo
            d'un coup — l'avantage des projets perso.
          </p>
          <p>
            Construit en discutant avec
            <a href="https://claude.com/claude-code" target="_blank" rel="noopener"
               class="text-eywa-bio-primary underline underline-offset-2 font-medium">Claude Code<span class="sr-only"> (nouvel onglet)</span></a>
            — pair-programmation, structure, code, et prose des fiches du codex synthétisée à
            partir de Pandorapedia et de l'Avatar Wiki. Depuis, <strong class="text-eywa-bio-primary">Codex</strong>
            m'accompagne aussi sur la relecture, les corrections ciblées et les itérations
            d'interface. Moi je trace la vision, choisis les couleurs, valide les tournures,
            repère ce qui cloche.
          </p>
          <p>
            Et les images du codex ? Elles montrent ce que nomme chaque fiche, tel qu'on le voit
            dans les films : personnages, créatures, engins, lieux et plantes ont des images
            officielles (plans des films et images de Pandorapedia), © 20th Century Studios, avec
            le crédit sous chaque image et sous chaque liste. Aucune n'est dessinée par un fan ni
            générée pour imiter un personnage ou une créature ; celles dont on n'a pas de bonne
            image gardent le visuel par défaut aux couleurs d'Eywa. Les fiches renvoient vers
            leur fiche officielle sur Pandorapedia.
          </p>
          <p>
            Seules quelques fiches d'ambiance (l'air de Pandora, sa nuit lumineuse, deux clans des
            plaines) gardent une <strong class="text-eywa-bio-primary">illustration générée pour Eywa</strong>,
            sur mon propre ordinateur, avec le modèle libre Stable Diffusion XL (licence CreativeML
            Open RAIL++-M) : elles évoquent une atmosphère sans prétendre reproduire un lieu précis.
          </p>
        </div>
      </div>
    </section>

    <section class="about-stack grid grid-cols-1 lg:grid-cols-3 gap-4">
      <h2 class="sr-only">Sous le capot</h2>
      {STACK.map((s) => (
        <div class="about-stack-card rounded-md border border-eywa-text-muted/20 bg-eywa-text/[0.02] p-5 hover:border-eywa-bio-primary/40 transition-colors">
          <h3 class="font-display font-semibold text-eywa-bio-primary tracking-wide text-sm uppercase mb-4 pb-3 border-b border-eywa-text-muted/20" aria-label={s.group}>
            <TitleText text={s.group} />
          </h3>
          <ul class="space-y-2 text-sm text-eywa-text-muted font-body">
            {s.items.map((it) => (
              <li class="flex items-start gap-2">
                <span class="text-eywa-bio-primary select-none mt-0.5" aria-hidden="true">›</span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="about-box rounded-md border border-eywa-text-muted/20 bg-eywa-text/[0.02] p-6">
      <h2 class="font-display text-lg font-semibold text-eywa-bio-primary mb-1" aria-label="Sources & inspirations">
        <TitleText text="Sources & inspirations" />
      </h2>
      <p class="text-sm text-eywa-text-muted mb-5 font-body">
        Pas une copie, mais des sources que j'ai consultées ou des principes que j'ai essayé d'appliquer.
      </p>
      <ul class="about-sources grid grid-cols-1 gap-3 list-none p-0 m-0">
        {SOURCES.map((i) => ({ ...i, address: addressParts(i.name, 'words' in i ? i.words : []) })).map((i) => (
          <li class="min-w-0">
          <a href={i.url} target="_blank" rel="noopener" aria-label={`${i.name} (nouvel onglet) par ${i.by} ${i.why}`}
             class="about-card group h-full rounded-md border border-eywa-text-muted/15 bg-eywa-text/[0.02] p-4 flex flex-col gap-1.5 hover:border-eywa-bio-primary/40 hover:bg-eywa-text/[0.04] transition-all">
            <div class="about-card__head flex items-center justify-between">
              <span class="about-source-name min-w-0 font-display font-semibold text-eywa-text group-hover:text-eywa-bio-primary transition-colors">
                {i.address ? i.address.map((part, k) => <Fragment>{k > 0 && <wbr />}{part}</Fragment>) : <TitleText text={i.name} />}<span class="sr-only"> (nouvel onglet)</span>
              </span>
              <span class="text-eywa-text-muted group-hover:text-eywa-bio-primary text-xs transition-colors" aria-hidden="true">↗</span>
            </div>
            <span class="about-by text-xs uppercase tracking-wider text-eywa-text-muted font-display">
              par {i.by}
            </span>
            <p class="about-why text-xs text-eywa-text-muted leading-relaxed mt-1 font-body">{i.why}</p>
          </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-box rounded-md border border-eywa-text-muted/20 bg-eywa-text/[0.02] p-6">
      <h2 class="font-display text-lg font-semibold text-eywa-bio-primary mb-1" aria-label="Mes autres sites"><TitleText text="Mes autres sites" /></h2>
      <p class="text-sm text-eywa-text-muted mb-5 font-body">
        Quatre autres apps perso vibe-codées avec Claude Code, puis relues et enrichies au fil
        des sessions avec Codex.
      </p>
      <ul class="about-sites grid grid-cols-1 gap-3 list-none p-0 m-0">
        {[
          { tag: '🦖', name: 'Evatosorus', desc: 'Codex Mésozoïque (cadeau pour Eva)', url: 'https://evatosorus.pages.dev' },
          { tag: '⚔️', name: 'Warhammer 40K Codex', desc: 'Fan codex narratif W40K', url: 'https://github.com/Sylad/warhammer40k' },
          { tag: '⚽', name: 'OL Companion', desc: 'Suivi Olympique Lyonnais', url: 'https://github.com/Sylad/ol-companion' },
          { tag: '💸', name: 'Finance Tracker', desc: 'Suivi finances perso (PDF Claude)', url: 'https://github.com/Sylad/finance-tracker' },
        ].map((s) => (
          <li class="min-w-0">
          <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.name} (nouvel onglet) ${s.desc}`}
            class="about-site h-full rounded-md border border-eywa-text-muted/20 p-3 flex items-center gap-3 hover:border-eywa-bio-primary/60 transition-colors group">
            <span class="text-2xl select-none" aria-hidden="true">{s.tag}</span>
            <span class="flex-1 min-w-0">
              <span class="block font-display font-semibold text-eywa-text group-hover:text-eywa-bio-primary transition-colors"><TitleText text={s.name} /><span class="sr-only"> (nouvel onglet)</span></span>
              <span class="about-site-desc block text-xs text-eywa-text-muted font-body">{s.desc}</span>
            </span>
            <span class="text-eywa-text-muted group-hover:text-eywa-bio-primary shrink-0" aria-hidden="true">↗</span>
          </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-end rounded-md border border-eywa-text-muted/20 bg-eywa-text/[0.02] p-6 text-center">
      <p class="text-eywa-text-muted text-sm leading-relaxed max-w-2xl mx-auto font-body">
        Si tu veux faire pareil : prends un sujet qui t'enflamme, ouvre un assistant de code,
        décris en langage naturel ce que tu rêves de voir exister, puis itère. Tu seras surpris
        de ce qu'on peut construire en quelques sessions.
      </p>
      <div class="about-sign text-xs uppercase tracking-[0.2em] text-eywa-text-muted mt-4 font-display">
        Eywa te voit · <span lang="en">Made with curiosity</span> · v1
      </div>
    </section>

    {/* L20 : Accueil, Nouveautés et Plan de travail (même rangée que l'accueil). */}
    <div class="flex justify-center pt-8">
      <FollowLinks home />
    </div>

  </main>
  </div>
</BaseLayout>

<style>
  /* L73 — texte très agrandi pour la largeur (page sous 14,5 em : 320 px dès 125 %, 390 px dès 155 %, 430 px dès
     170 % ; jamais un réglage à 100 % au-dessus de 254 px) : marges latérales de la page, des encadrés et des cartes de
     sources à leur taille du réglage normal, comme le codex (L71). Sinon « Claude » (275 px à 320 px texte 200 %) se
     cassait sans trait dans un titre de 215 px, et « Pandorapedia » faisait défiler la page de côté.
     L74 (revue UX r2 de L73, m3) : à 13 em, le seuil venait trop tard — entre 13 et 14,1 em de page, « refactoringui »,
     « Finance » et « COMMUNAUTÉ » sortaient de leur carte de 1 à 37 px (320 px 130–140 %, 385 px 155–165 %, 430 px
     175–185 %), sans faire défiler la page. */
  .about-frame {
    container: eywa-about / inline-size;
  }
  /* L74 — sources et sites sur deux colonnes dès 768 px (ancien `md:grid-cols-2`), mais seulement si la page fait au
     moins 24 em de sa police : un point de rupture de la fenêtre ne voit pas le texte agrandi, et à 768 px texte 195 et
     200 %, « refactoringui », « Finance » et « COMMUNAUTÉ » sortaient de leur carte de 5 à 18 px (même règle que la
     grille du codex, L70). Au réglage normal, la page fait 43,9 em à 768 px : rendu inchangé. */
  @media (min-width: 48rem) {
    @container eywa-about (min-width: 24em) {
      .about-sources,
      .about-sites {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  }
  @container eywa-about (max-width: 14.5em) {
    main {
      padding-inline: 0.5rem;
    }
    /* L78 : 0,25 rem (0,5 avant) — à 320 px texte 200 % du réglage du navigateur (35 px), « refactoring » (215 px)
       dépassait de 4 px la carte (211 px) et se coupait sans trait ; les cartes gardent leur marge intérieure. */
    .about-box {
      padding-inline: 0.25rem;
    }
    .about-card {
      padding-inline: 0.5rem;
    }
    /* Nom d'une source : coupé à ses syllabes (TitleText ; le lien porte son nom sans U+00AD en aria-label), sauf
       « refactoringui.com » (342 px à 320 px texte 175 %), une adresse, qui passe à la ligne avant son point (<wbr>,
       aussi au-dessus de ce gabarit : revue UX r1 de L73, elle sortait de sa carte de 4 à 15 px entre 150 et 195 %), puis
       entre les mots de son nom (L78 : « refactoring / ui.com », jusqu'à 320 px texte 200 % et 35 px) et
       se coupe ici sans trait en dernier recours (usage typographique : jamais de trait ajouté dans une adresse). */
    .about-source-name {
      overflow-wrap: anywhere;
    }
    /* « PAR COMMUNAUTÉ DE FANS » en capitales espacées : « COMMUNAUTÉ » dépassait de sa carte de 4 px à 320 px texte
       200 % ; lettres à leur espacement normal ici (13 px gagnés). */
    .about-by {
      letter-spacing: normal;
    }
    /* Écart entre le nom et la flèche seulement ici : à 100 %, la ligne garde sa géométrie d'avant L73.
       L78 : la flèche suit le nom dans le texte au lieu de lui prendre une colonne — le nom a toute la largeur de la
       carte et « refactoring » (198 px à 320 px texte 200 %) tient sur sa ligne (192 px à côté de la flèche). */
    .about-card__head {
      display: block;
    }
    .about-card__head > [aria-hidden='true'] {
      margin-inline-start: 0.5rem;
    }
    /* « Mes autres sites » : nom et description sous l'emoji et la flèche (nom en mots coupés à leurs syllabes, le lien
       porte son nom sans U+00AD en aria-label). À côté d'eux, « Evatosorus » avait 60 px. */
    .about-site {
      flex-wrap: wrap;
      padding-inline: 0.5rem;
    }
    .about-site > .flex-1 {
      order: 3;
      flex-basis: 100%;
    }
    .about-site > :last-child {
      margin-inline-start: auto;
    }
    /* Rangée « Suivre le codex » : sa marge négative (-0,6 rem sous 400 px) dépassait la marge réduite de la page. */
    .about-frame :global(.landing-follow) {
      margin-inline: 0;
      max-width: 100%;
    }
  }

  /* L78 r2 (QA de prod du 25-11) — page plus étroite encore pour son texte (sous 10,75 em, seuil du codex : 320 px texte
     175 et 200 %, jamais un réglage à 100 %). À 320 px, un Chrome de bureau garde 15 px à sa barre de défilement : la
     page n'a que 305 px, et à texte 200 % « Claude » (h1, 275 px pour 270), « refactoring », « COMMUNAUTÉ »,
     « bioluminescente » et « CURIOSITY » dépassaient leur ligne et se cassaient sans trait. Marges de la page à 0,25 rem,
     encadrés de la pile et de la fin à la marge des autres, lettres de la signature à leur espacement normal. */
  @container eywa-about (max-width: 10.75em) {
    main {
      padding-inline: 0.25rem;
    }
    .about-stack-card,
    .about-end {
      padding-inline: 0.5rem;
    }
    .about-sign {
      letter-spacing: normal;
    }
  }

  /* Anneau de focus clavier explicite (WCAG 2.4.7 / 1.4.11) : l'anneau « auto » reste à 1 px
     sur ces cartes translucides et sur le lien en ligne des paragraphes. */
  .about-sources a:focus-visible,
  .about-sites a:focus-visible,
  main p a:focus-visible {
    outline: 2px solid var(--color-eywa-bio-primary);
    outline-offset: 3px;
  }
</style>
