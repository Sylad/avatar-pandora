---
import { getCollection, render } from 'astro:content';
import CodexLayout from '../../layouts/CodexLayout.astro';
import EntryCover from '../../components/EntryCover.astro';

export async function getStaticPaths() {
  const entries = await getCollection('bestiaire');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

---
<CodexLayout title={`${entry.data.title} — Eywa`} current="bestiaire">
  <article class="reading-veil max-w-3xl mx-auto">
    <EntryCover cover={entry.data.cover} coverAlt={entry.data.coverAlt} coverCredit={entry.data.coverCredit} pandorapedia={entry.data.pandorapedia} water={entry.data.water} title={entry.data.title} section="Bestiaire" />
    <h1 class="entry-title font-display text-eywa-bio-primary mb-3">{entry.data.title}</h1>
    <p class="text-eywa-text-muted text-lg italic mb-10">{entry.data.summary}</p>
    <div class="entry-body text-eywa-text leading-relaxed font-body text-lg sm:text-xl">
      <Content />
    </div>
    <nav aria-label="Retour à la liste" class="mt-16 pt-8 border-t border-eywa-text-muted/20">
      <a href="/bestiaire/" class="inline-flex items-center min-h-11 text-eywa-text-muted hover:text-eywa-bio-primary transition">
        ← Tout le bestiaire
      </a>
    </nav>
  </article>
</CodexLayout>
