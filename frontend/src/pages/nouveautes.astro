---
/*
  Nouveautés — journal des évolutions visibles du site (signature commune des apps, L14).

  Source : docs/nouveautes/*.md, compilé par `cadence news build` (`npm run news`)
  dans public/nouveautes-data/ (nouveautes.json + captures), versionné : Cloudflare
  Pages construit sans cadence. La page est rendue AU BUILD depuis ce JSON, déjà
  trié du plus récent au plus ancien (date, puis heure de création).
*/
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import CodexLayout from '../layouts/CodexLayout.astro';
import news from '../../public/nouveautes-data/nouveautes.json';

interface NewsEntry {
  slug: string;
  title: string;
  date: string;
  lots: string[];
  captures: string[];
  html: string;
}

const BASE = '/nouveautes-data';
const entries = (news as { entries: NewsEntry[] }).entries;

const formatDate = (day: string) =>
  new Date(`${day}T12:00:00Z`).toLocaleDateString('fr-FR', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });

// Dimensions lues dans l'en-tête PNG (IHDR) : réservent la place des captures,
// pas de saut de mise en page au chargement.
const pngSize = (rel: string) => {
  const buf = readFileSync(join(process.cwd(), 'public', 'nouveautes-data', rel));
  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
};
---
<CodexLayout title="Nouveautés — Eywa" current="nouveautes">
  <div class="news">
    <header class="news-header">
      <p class="news-eyebrow">Nouveautés · Eywa</p>
      <h1 class="news-title">Ce qui a changé</h1>
      <p class="news-lede">
        Le journal des évolutions du codex, la plus récente en premier.
      </p>
    </header>

    {entries.length === 0 ? (
      <p class="news-empty">Aucune nouveauté publiée pour l'instant.</p>
    ) : (
      <ol class="news-list">
        {entries.map((e) => (
          <li>
            <article class="news-entry" id={e.slug} aria-labelledby={`${e.slug}-titre`}>
              <p class="news-date"><time datetime={e.date}>{formatDate(e.date)}</time></p>
              <h2 id={`${e.slug}-titre`}>{e.title}</h2>
              {/* HTML produit par cadence depuis le Markdown du dépôt (texte échappé à la génération). */}
              <div class="news-body" set:html={e.html} />
              {e.captures.length > 0 && (
                <div class="news-captures" data-lightbox>
                  {e.captures.map((c, i) => {
                    const { width, height } = pngSize(c);
                    const alt = e.captures.length > 1
                      ? `Capture d'écran ${i + 1} sur ${e.captures.length} : ${e.title}`
                      : `Capture d'écran : ${e.title}`;
                    return (
                      <a
                        href={`${BASE}/${c}`}
                        class="news-capture"
                        style={`width: min(100%, ${width}px, calc(32rem * ${width} / ${height}))`}
                      >
                        <img
                          src={`${BASE}/${c}`}
                          alt={alt}
                          width={width}
                          height={height}
                          style={`aspect-ratio: ${width} / ${height}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    );
                  })}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    )}
  </div>

  <style>
    .news {
      max-width: 46rem;
    }
    .news-header {
      margin-bottom: 2.5rem;
    }
    /* Sur-titre et chapeau posés sur l'ambiance (dégradés, particules, halo du
       curseur) : ombre sombre serrée, ≥ 4,5:1 au pire pixel (test header-contrast). */
    .news-eyebrow {
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-eywa-text-muted);
      margin: 0 0 0.5rem;
      text-shadow: 0 0 2px rgba(10, 10, 31, 0.95), 0 1px 3px rgba(10, 10, 31, 0.9);
    }
    .news-title {
      font-family: var(--font-display);
      font-size: clamp(1.7rem, 6vw, 2.25rem);
      font-weight: 700;
      line-height: 1.2;
      color: var(--color-eywa-bio-primary);
      margin: 0 0 0.8rem;
      overflow-wrap: anywhere;
    }
    .news-lede {
      font-family: var(--font-body);
      font-size: 1.15rem;
      line-height: 1.6;
      color: var(--color-eywa-text-muted);
      margin: 0;
      text-shadow: 0 0 2px rgba(10, 10, 31, 0.95), 0 1px 3px rgba(10, 10, 31, 0.9);
    }
    .news-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    /* Carte quasi opaque (même nuit que le tiroir et le bouton menu) : le texte garde
       son contraste quoi qu'il passe derrière (particules, halo du curseur). */
    .news-entry {
      position: relative;
      padding: 1.5rem clamp(1rem, 4vw, 1.8rem) 1.75rem;
      background: rgba(8, 12, 22, 0.92);
      border: 1px solid rgba(95, 255, 230, 0.18);
      border-left: 3px solid var(--color-eywa-bio-primary);
      border-radius: 6px;
      box-shadow: 0 0 30px -12px rgba(95, 255, 230, 0.35);
    }
    .news-date {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-eywa-bio-primary);
      margin: 0 0 0.5rem;
    }
    .news-entry h2 {
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 4vw, 1.3rem);
      font-weight: 600;
      letter-spacing: 0.03em;
      line-height: 1.4;
      color: var(--color-eywa-text);
      margin: 0 0 1rem;
      overflow-wrap: anywhere;
    }
    .news-body :global(p),
    .news-body :global(li) {
      font-size: 1.08rem;
      line-height: 1.7;
      color: var(--color-eywa-text);
    }
    .news-body :global(p) { margin: 0 0 0.8rem; }
    .news-body :global(ul) {
      margin: 0 0 0.8rem;
      padding-left: 1.3rem;
      list-style: disc;
    }
    .news-body :global(li) { margin-bottom: 0.45rem; }
    .news-body :global(li::marker) { color: var(--color-eywa-bio-primary); }
    .news-body :global(strong) { color: var(--color-eywa-text); font-weight: 700; }
    .news-body :global(code) {
      font-size: 0.9em;
      padding: 0 0.3em;
      border-radius: 3px;
      background: rgba(95, 255, 230, 0.1);
    }
    .news-body :global(a) {
      color: var(--color-eywa-bio-primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .news-captures {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    .news-capture {
      display: block;
      flex: 0 1 auto;
      min-width: 0;
      max-width: 100%;
      border-radius: 4px;
      line-height: 0;
    }
    .news-capture:focus-visible {
      outline: 2px solid var(--color-eywa-bio-primary);
      outline-offset: 3px;
    }
    /* Taille réservée AVANT chargement (pas de saut de mise en page) : le lien prend
       min(largeur dispo, largeur naturelle, largeur qui donne 32rem de haut), l'image
       le remplit à ses proportions (aspect-ratio en ligne). Une capture de téléphone
       ne s'étire pas, une capture de bureau ne déborde jamais. */
    .news-capture img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid rgba(95, 255, 230, 0.25);
      border-radius: 4px;
      cursor: zoom-in;
    }
    .news-empty {
      color: var(--color-eywa-text-muted);
      font-style: italic;
    }
  </style>
</CodexLayout>
