---
/*
  Nouveautés — journal des évolutions visibles du site (signature commune des apps, L14).

  Source : docs/nouveautes/*.md, compilé par `cadence news build` (`npm run news`)
  dans public/nouveautes-data/ (nouveautes.json + captures), versionné : Cloudflare
  Pages construit sans cadence. La page est rendue AU BUILD depuis ce JSON, déjà
  trié du plus récent au plus ancien (date, puis heure de création).
*/
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import CodexLayout from '../layouts/CodexLayout.astro';
import MetaHeader from '../components/MetaHeader.astro';
import FrDate from '../components/FrDate.astro';
import news from '../../public/nouveautes-data/nouveautes.json';

interface NewsEntry {
  slug: string;
  title: string;
  date: string;
  lots: string[];
  captures: string[];
  html: string;
}

const BASE = '/nouveautes-data';
const entries = (news as { entries: NewsEntry[] }).entries;


// Dimensions lues dans l'en-tête PNG (IHDR) : réservent la place des captures,
// pas de saut de mise en page au chargement.
const pngSize = (rel: string) => {
  const buf = readFileSync(join(process.cwd(), 'public', 'nouveautes-data', rel));
  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
};
---
<CodexLayout title="Nouveautés — Eywa" current="nouveautes">
  <div class="news">
    <MetaHeader
      eyebrow="Nouveautés · Eywa"
      title="Ce qui a changé"
      lede="Le journal des évolutions du codex, la plus récente en premier."
    >
      {/* L21 : rempli au chargement selon ta dernière visite (script de BaseLayout). */}
      <p class="news-since" role="status"></p>
      <p id="news-copy-status" class="sr-only" role="status"></p>
    </MetaHeader>

    {entries.length === 0 ? (
      <p class="news-empty">Aucune nouveauté publiée pour l'instant.</p>
    ) : (
      <ol class="news-list">
        {entries.map((e) => (
          <li>
            <article class="news-entry" id={e.slug} tabindex="-1" aria-labelledby={`${e.slug}-titre`}>
              {/* L21 (repris d'evatosorus après sa revue UX) : lien permanent par un bouton
                  « Copier le lien » visible sans survol, après la date et la marque « Nouveau » ;
                  le titre reste du texte. Copier ne fait ni défiler ni changer l'adresse. */}
              <p class="news-date">
                <time datetime={e.date}><FrDate day={e.date} /></time><span class="news-new-slot"></span>
                <button type="button" class="news-copy" data-slug={e.slug} data-state="idle">
                  <svg class="news-copy-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 13.5a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.2 1.2" />
                    <path d="M14 10.5a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.2-1.2" />
                  </svg>
                  {/* Les trois libellés partagent la même case : la largeur du plus long est
                      réservée, le retour ne décale rien. */}
                  <span class="news-copy-labels" aria-hidden="true">
                    <span class="news-copy-label" data-for="idle">Copier le lien</span>
                    <span class="news-copy-label is-hidden" data-for="ok">Lien copié</span>
                    <span class="news-copy-label is-hidden" data-for="ko">Lien dans l’adresse</span>
                  </span>
                  <span class="sr-only">Copier le lien : {e.title}</span>
                </button>
              </p>
              <h2 id={`${e.slug}-titre`}>{e.title}</h2>
              {/* HTML produit par cadence depuis le Markdown du dépôt (texte échappé à la génération). */}
              <div class="news-body" set:html={e.html} />
              {e.captures.length > 0 && (
                <div class="news-captures" data-lightbox>
                  {e.captures.map((c, i) => {
                    const { width, height } = pngSize(c);
                    const alt = e.captures.length > 1
                      ? `Capture d'écran ${i + 1} sur ${e.captures.length} : ${e.title}`
                      : `Capture d'écran : ${e.title}`;
                    return (
                      <a
                        href={`${BASE}/${c}`}
                        class="news-capture"
                        style={`width: min(100%, ${width}px, calc(32rem * ${width} / ${height}))`}
                      >
                        <img
                          src={`${BASE}/${c}`}
                          alt={alt}
                          width={width}
                          height={height}
                          style={`aspect-ratio: ${width} / ${height}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    );
                  })}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    )}
  </div>

  <style>
    .news {
      max-width: 46rem;
    }
    .news-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    /* Carte quasi opaque (même nuit que le tiroir et le bouton menu) : le texte garde
       son contraste quoi qu'il passe derrière (particules, halo du curseur). */
    .news-entry {
      position: relative;
      padding: 1.5rem clamp(1rem, 4vw, 1.8rem) 1.75rem;
      background: rgba(8, 12, 22, 0.92);
      border: 1px solid rgba(95, 255, 230, 0.18);
      border-left: 3px solid var(--color-eywa-bio-primary);
      border-radius: 6px;
      box-shadow: 0 0 30px -12px rgba(95, 255, 230, 0.35);
    }
    /* Arrivée par /nouveautes/#<slug> : l'entrée s'arrête sous le bouton menu (téléphone)
       et s'illumine. */
    .news-entry {
      scroll-margin-top: 5rem;
    }
    @media (min-width: 1024px) {
      .news-entry { scroll-margin-top: 2rem; }
    }
    .news-entry:focus {
      outline: none;
    }
    .news-entry.is-target {
      border-color: rgba(95, 255, 230, 0.6);
      box-shadow: 0 0 0 1px rgba(95, 255, 230, 0.45), 0 0 36px -8px rgba(95, 255, 230, 0.6);
    }
    /* L21 — « Copier le lien » : visible sans survol, cible ≥ 24 px au bureau et ≥ 44 px au
       toucher ; le retour remplace le libellé dans une case de largeur fixe (le plus long). */
    .news-copy {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 1.75rem;
      min-width: 1.5rem;
      padding: 0 0.6rem;
      border: 1px solid rgba(95, 255, 230, 0.35);
      border-radius: 4px;
      background: transparent;
      color: var(--color-eywa-text);
      font-family: var(--font-body);
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      text-transform: none;
      cursor: pointer;
      transition: border-color 200ms ease, background-color 200ms ease;
    }
    .news-copy:hover {
      border-color: var(--color-eywa-bio-primary);
      background-color: rgba(95, 255, 230, 0.08);
    }
    .news-copy:focus-visible {
      outline: 2px solid var(--color-eywa-bio-primary);
      outline-offset: 2px;
    }
    @media (pointer: coarse) {
      .news-copy { min-height: 2.75rem; min-width: 2.75rem; }
    }
    .news-copy-icon {
      flex: none;
      color: var(--color-eywa-bio-primary);
    }
    .news-copy-labels {
      display: inline-grid;
      text-align: start;
    }
    .news-copy-label {
      grid-area: 1 / 1;
      white-space: nowrap;
    }
    .news-copy-label.is-hidden {
      visibility: hidden;
    }
    /* L21 — « N nouveautés depuis ta dernière visite » : bandeau sur la nuit des cartes,
       masqué quand il est vide. */
    .news-since {
      margin: 1.25rem 0 0;
      padding: 0.6rem 1rem;
      background: rgba(8, 12, 22, 0.92);
      border-left: 3px solid var(--color-eywa-bio-secondary);
      border-radius: 4px;
      font-family: var(--font-body);
      font-size: 1.05rem;
      color: var(--color-eywa-text);
    }
    .news-since:empty {
      display: none;
    }
    /* Marque « Nouveau » : un mot écrit, pas seulement une couleur (rose : la couleur du
       point du bouton menu). */
    .news :global(.news-new) {
      display: inline-block;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      background: var(--color-eywa-bio-secondary);
      color: #0a0a1f;
      font-weight: 700;
      letter-spacing: 0.12em;
    }
    .news-new-slot:empty {
      display: none;
    }
    .news-date {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-eywa-bio-primary);
      margin: 0 0 0.5rem;
    }
    .news-entry h2 {
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 4vw, 1.3rem);
      font-weight: 600;
      letter-spacing: 0.03em;
      line-height: 1.4;
      color: var(--color-eywa-text);
      margin: 0 0 1rem;
      overflow-wrap: anywhere;
    }
    .news-body :global(p),
    .news-body :global(li) {
      font-size: 1.08rem;
      line-height: 1.7;
      color: var(--color-eywa-text);
    }
    .news-body :global(p) { margin: 0 0 0.8rem; }
    .news-body :global(ul) {
      margin: 0 0 0.8rem;
      padding-left: 1.3rem;
      list-style: disc;
    }
    .news-body :global(li) { margin-bottom: 0.45rem; }
    .news-body :global(li::marker) { color: var(--color-eywa-bio-primary); }
    .news-body :global(strong) { color: var(--color-eywa-text); font-weight: 700; }
    .news-body :global(code) {
      font-size: 0.9em;
      padding: 0 0.3em;
      border-radius: 3px;
      background: rgba(95, 255, 230, 0.1);
    }
    .news-body :global(a) {
      color: var(--color-eywa-bio-primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .news-captures {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    .news-capture {
      display: block;
      flex: 0 1 auto;
      min-width: 0;
      max-width: 100%;
      border-radius: 4px;
      line-height: 0;
    }
    .news-capture:focus-visible {
      outline: 2px solid var(--color-eywa-bio-primary);
      outline-offset: 3px;
    }
    /* Taille réservée AVANT chargement (pas de saut de mise en page) : le lien prend
       min(largeur dispo, largeur naturelle, largeur qui donne 32rem de haut), l'image
       le remplit à ses proportions (aspect-ratio en ligne). Une capture de téléphone
       ne s'étire pas, une capture de bureau ne déborde jamais. */
    .news-capture img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid rgba(95, 255, 230, 0.25);
      border-radius: 4px;
      cursor: zoom-in;
    }
    /* L21 — « Déjà vu lors de ta visite du … » : séparateur HORS des listes (role
       separator nommé, posé entre la liste des nouvelles et celle des déjà vues par le
       script de BaseLayout), d'où :global. Texte sur une pastille de nuit opaque. */
    .news :global(.news-seen-sep) {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1.75rem 0;
    }
    .news :global(.news-seen-sep)::before,
    .news :global(.news-seen-sep)::after {
      content: '';
      flex: 1;
      min-width: 1rem;
      border-top: 1px solid rgba(95, 255, 230, 0.3);
    }
    .news :global(.news-seen-sep span) {
      flex: 0 1 auto;
      padding: 0.3rem 0.85rem;
      border-radius: 999px;
      background: rgba(8, 12, 22, 0.95);
      border: 1px solid rgba(95, 255, 230, 0.25);
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1rem;
      line-height: 1.4;
      text-align: center;
      color: var(--color-eywa-text);
    }
    .news-empty {
      color: var(--color-eywa-text-muted);
      font-style: italic;
    }
  </style>

  <script>
    /*
      L21 — « Copier le lien » et arrivée sur /nouveautes/#<slug> (repris d'evatosorus).
      ClientRouter : ce module ne s'exécute qu'une fois ; écouteurs posés sur document,
      éléments retrouvés à chaque événement, arrivée rejouée à chaque astro:page-load.
      Copier : presse-papiers seulement, sans défilement ni changement d'adresse ; retour
      dans le libellé (largeur réservée) et annonce pour lecteur d'écran. Copie refusée :
      le lien est posé dans l'adresse SANS défiler (replaceState).
    */
    import { entryForFragment, permalink } from '../lib/news-anchor';

    const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
    const setState = (btn: HTMLElement, state: 'idle' | 'ok' | 'ko') => {
      btn.dataset.state = state;
      btn.querySelectorAll<HTMLElement>('.news-copy-label').forEach((l) => {
        l.classList.toggle('is-hidden', l.dataset.for !== state);
      });
    };
    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element | null)?.closest?.<HTMLElement>('button.news-copy');
      if (!btn) return;
      const slug = btn.dataset.slug!;
      let ok = true;
      try {
        await navigator.clipboard.writeText(permalink(location.origin, slug));
      } catch {
        ok = false;
        history.replaceState(history.state, '', `#${encodeURIComponent(slug)}`);
      }
      setState(btn, ok ? 'ok' : 'ko');
      const status = document.getElementById('news-copy-status');
      if (status) {
        status.textContent = ok ? 'Lien copié dans le presse-papiers' : 'Copie impossible : le lien est dans la barre d’adresse';
      }
      clearTimeout(timers.get(btn));
      timers.set(btn, setTimeout(() => {
        setState(btn, 'idle');
        const s = document.getElementById('news-copy-status');
        if (s) s.textContent = '';
      }, 4000));
    });

    // Arrivée sur une ancre (ou changement d'ancre) : l'entrée est signalée et reçoit le
    // focus ; elle s'arrête sous le bouton menu (scroll-margin-top).
    const revealTarget = () => {
      const articles = [...document.querySelectorAll<HTMLElement>('article.news-entry')];
      if (!articles.length) return;
      const slug = entryForFragment(location.hash, articles.map((a) => ({ slug: a.id })));
      for (const a of articles) a.classList.toggle('is-target', a.id === slug);
      if (!slug) return;
      const el = document.getElementById(slug)!;
      el.focus({ preventScroll: true });
      el.scrollIntoView({ block: 'start' });
    };
    document.addEventListener('astro:page-load', revealTarget);
    window.addEventListener('hashchange', revealTarget);
    // Revue UX L21 : ClientRouter traite lui-même un lien vers une ancre de la même page
    // (pushState, sans « hashchange ») et le retour arrière (popstate) — on relit l'ancre
    // une fois l'adresse mise à jour.
    const later = () => { setTimeout(revealTarget, 0); setTimeout(revealTarget, 150); };
    window.addEventListener('popstate', later);
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href*="#"]');
      if (!a || a.origin !== location.origin || a.pathname !== location.pathname) return;
      later();
    });
  </script>
</CodexLayout>
