---
import BaseLayout from '../layouts/BaseLayout.astro';
import EywaLogo from '../components/EywaLogo.astro';
import AtmospherePause from '../components/AtmospherePause.astro';
import NewsBadge from '../components/NewsBadge.astro';
import { LandingParticles } from '../components/cinema/LandingParticles';
import { CycleBackdrop } from '../components/cinema/CycleBackdrop';
---
<BaseLayout title="Eywa — Codex de Pandora" description="Un codex visuel de Pandora — la lune, ses clans, sa faune, sa langue.">

  <!--
    Landing — single viewport, no scroll. Behind the content :
      1. CycleBackdrop : 6 Pandora location images cross-fading on a
         75-second loop (forêt → Hometree → Hallelujah → Metkayina →
         Fire & Ash → reveal).
      2. LandingParticles → CinemaCanvas (mode='time'), loaded only
         outside reduced motion : the bioluminescent particle field
         drives uniforms on the SAME 75s loop, so atmosphere colors
         match the visible image.
      3. Bio-ambient gradient (the 4 radial blobs from CodexLayout
         pattern) for global cohesion with the codex pages.
    The user sits, breathes, and Pandora transforms around them.
  -->
  <CycleBackdrop client:only="react" />
  <LandingParticles client:only="react" />
  <div class="bio-ambient" aria-hidden="true"></div>

  <main class="relative z-10 min-h-screen flex flex-col items-center justify-center text-center px-6 py-20 max-[399px]:px-4 max-[399px]:py-8">
    <!-- Titre de la page : le logo (svg role=img, aria-label « Eywa ») donne son nom au h1. -->
    <h1 class="w-full flex justify-center m-0 leading-none">
      <EywaLogo size={420} fluid />
    </h1>
    <p class="mt-6 max-[399px]:mt-4 max-w-2xl text-eywa-text text-lg italic font-body landing-eywa-def" data-bio-split>
      <a href="/pandora/eywa/" class="eywa-link">Eywa</a> — déesse-mère et conscience-réseau de Pandora,
      mémoire vivante de tout ce qui respire.
    </p>
    <p class="mt-6 max-[399px]:mt-4 max-w-xl text-eywa-text text-xl italic font-body landing-tagline" data-bio-split>
      « Je te vois. »<br/>
      Un codex visuel de Pandora — la lune, ses <a href="/clans/" class="eywa-link">clans</a>,
      sa <a href="/bestiaire/" class="eywa-link">faune</a>, sa <a href="/langue/" class="eywa-link">langue</a>.
    </p>
    <div class="mt-12 max-[399px]:mt-6 flex flex-wrap gap-4 max-[399px]:gap-3 justify-center">
      <a href="/pandora/intro/"
         class="px-6 py-3 rounded border border-eywa-bio-primary text-eywa-bio-primary hover:shadow-glow-bio transition-shadow backdrop-blur-sm bg-eywa-bg/30">
        Explorer le codex
      </a>
      <a href="/about/"
         class="px-6 py-3 rounded text-eywa-text-muted hover:text-eywa-text transition-colors backdrop-blur-sm bg-eywa-bg/50">
        À propos
      </a>
    </div>
    <!--
      Suivre le codex (L20, consigne de Sylvain : Nouveautés et Plan de travail proposés
      partout où le site a une navigation, accueil compris). Une seconde rangée de deux liens
      discrets sous les deux boutons : jamais un lien seul sur sa ligne, au bureau comme au
      téléphone (320 px compris). Mêmes icônes que dans le menu du codex ; même pastille.
    -->
    <nav class="landing-follow mt-4 max-[399px]:mt-3" aria-label="Suivre le codex">
      <a href="/nouveautes/" class="landing-follow__link">
        <svg class="landing-follow__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9-1.9 5.1-1.9-5.1-5.1-1.9 5.1-1.9z" />
          <path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" />
        </svg>
        <span>Nouveautés</span>
        <NewsBadge />
      </a>
      <a href="/plan-de-travail/" class="landing-follow__link">
        <svg class="landing-follow__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6.5l1.6 1.6L8.5 5" />
          <path d="M4 12.5l1.6 1.6 2.9-3.1" />
          <circle cx="6" cy="18.5" r="1.6" />
          <path d="M11.5 6.5H20M11.5 12.5H20M11.5 18.5H20" />
        </svg>
        <span>Plan de travail</span>
      </a>
    </nav>
  </main>
  <AtmospherePause />
</BaseLayout>

<script is:inline>
  // Wrap the landing tagline words in <span class="bio-word"> so each
  // glows cyan when the cursor passes over it — same effect as the
  // codex prose. Preserves <br> and other inline elements.
  (() => {
    if (typeof window === 'undefined') return;
    const split = () => {
      const targets = document.querySelectorAll('[data-bio-split]');
      targets.forEach((p) => {
        if (p.dataset.bioSplitDone === '1') return;
        Array.from(p.childNodes).forEach((node) => {
          if (node.nodeType !== Node.TEXT_NODE) return;
          const text = node.textContent ?? '';
          if (!text.trim()) return;
          const frag = document.createDocumentFragment();
          text.split(/(\s+)/).forEach((tok) => {
            if (/^\s+$/.test(tok) || tok === '') {
              frag.appendChild(document.createTextNode(tok));
            } else {
              const span = document.createElement('span');
              span.className = 'bio-word';
              span.textContent = tok;
              frag.appendChild(span);
            }
          });
          p.replaceChild(frag, node);
        });
        p.dataset.bioSplitDone = '1';
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', split);
    } else {
      split();
    }
    document.addEventListener('astro:page-load', split);
  })();
</script>

<style>
  /*
    The cycling images are vivid — the foreground content needs a hint
    of dark veil under it for legibility. A bottom-up gradient does the
    job without darkening the whole viewport.
    z-index -1 : `main` (relative z-10) is its own stacking context, so
    the veil sits above the backdrop and particles but UNDER the text.
    It used to be at 5, i.e. on top of the text, which dimmed the words
    instead of the images (WCAG 1.4.3).
  */
  main::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(10, 10, 31, 0.30) 0%,
      rgba(10, 10, 31, 0.55) 100%);
  }

  /* Tagline + logo get a stronger halo for readability above the
     vivid Pandora images cycling underneath. Two layers : a tight
     dark drop-shadow for crisp legibility, then a soft cyan glow that
     ties it back to the bioluminescent palette. */
  .landing-tagline,
  .landing-eywa-def {
    text-shadow:
      0 2px 8px rgba(10, 10, 31, 0.95),
      0 0 18px rgba(10, 10, 31, 0.85),
      0 0 30px rgba(95, 255, 230, 0.15);
  }

  /* Words of the landing sentences : hover and touch pulse light up with a
     magenta halo but KEEP the text colour. They used to turn the link cyan
     (#5fffe6) and could be mistaken for the real links (Eywa, clans, faune,
     langue). */
  .landing-tagline :global(.bio-word:hover),
  .landing-eywa-def :global(.bio-word:hover) {
    color: inherit;
    text-shadow:
      0 0 8px rgba(255, 93, 196, 0.75),
      0 0 18px rgba(255, 93, 196, 0.4),
      0 2px 8px rgba(10, 10, 31, 0.95);
  }
  .landing-tagline :global(.bio-word.is-pulsing),
  .landing-eywa-def :global(.bio-word.is-pulsing) {
    animation-name: landing-word-glow;
  }
  @keyframes landing-word-glow {
    0%, 100% {
      color: inherit;
      text-shadow: 0 2px 8px rgba(10, 10, 31, 0.95), 0 0 18px rgba(10, 10, 31, 0.85);
    }
    35%, 65% {
      color: inherit;
      text-shadow:
        0 0 8px rgba(255, 93, 196, 0.75),
        0 0 18px rgba(255, 93, 196, 0.4),
        0 2px 8px rgba(10, 10, 31, 0.95);
    }
  }

  /* The "Eywa" link in the definition line. Rest state : a soft cyan
     baseline that hints "clickable" without screaming. Hover : the
     word lights up like a bio-word does in the codex prose. */
  .eywa-link {
    color: var(--color-eywa-bio-primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(95, 255, 230, 0.35);
    transition: color 250ms ease, text-shadow 250ms ease, border-color 250ms ease;
    text-shadow:
      0 0 8px rgba(95, 255, 230, 0.25),
      0 1px 2px rgba(10, 10, 31, 0.85);
  }
  .eywa-link:hover,
  .eywa-link:focus-visible {
    color: var(--color-eywa-bio-primary);
    border-color: var(--color-eywa-bio-primary);
    text-shadow:
      0 0 10px rgba(95, 255, 230, 0.85),
      0 0 22px rgba(95, 255, 230, 0.55),
      0 1px 2px rgba(10, 10, 31, 0.85);
  }

  /* Seconde rangée « Suivre le codex » : deux liens discrets (plus petits que les deux
     boutons au-dessus), côte à côte à toutes les largeurs — 320 px compris — donc jamais
     un lien orphelin sur sa ligne. Cible ≥ 44 px de haut, texte muted sur le voile de
     nuit des boutons, contour de focus cyan. */
  .landing-follow {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .landing-follow__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-eywa-text-muted);
    background: rgba(10, 10, 31, 0.5);
    backdrop-filter: blur(4px);
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(10, 10, 31, 0.85);
    transition: color 250ms ease, box-shadow 250ms ease;
  }
  .landing-follow__link:hover,
  .landing-follow__link:focus-visible {
    color: var(--color-eywa-text);
    box-shadow: 0 0 18px -6px rgba(95, 255, 230, 0.5);
  }
  .landing-follow__link:focus-visible {
    outline: 2px solid var(--color-eywa-bio-primary);
    outline-offset: 2px;
  }
  .landing-follow__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-eywa-bio-primary);
    opacity: 0.8;
  }
  /* Petit téléphone bas (320×568) : la seconde rangée ne doit pas faire défiler
     l'accueil — marge basse resserrée (le haut reste celui de la revue L2). */
  @media (max-width: 399px) and (max-height: 600px) {
    main {
      padding-bottom: 1rem;
    }
  }
  @media (max-width: 399px) {
    .landing-follow { gap: 0.35rem; }
    .landing-follow__link { padding: 0 0.6rem; gap: 0.35rem; }
  }

  /* Bio-ambient gradient — same recipe as CodexLayout but slightly
     louder since the backdrop is more vivid here. */
  .bio-ambient {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 15% 15%, rgba(95, 255, 230, 0.10), transparent 70%),
      radial-gradient(ellipse 50% 35% at 85% 35%, rgba(255, 93, 196, 0.08), transparent 70%),
      radial-gradient(ellipse 70% 50% at 50% 90%, rgba(127, 255, 143, 0.08), transparent 70%);
  }
</style>
