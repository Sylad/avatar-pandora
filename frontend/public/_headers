# Headers globaux — sécurité minimum syndical pour un site public statique
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Assets versionnés (Astro hash dans le nom) — cache long agressif
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Vidéos hero MP4 — cache long aussi (immuables côté contenu)
/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# Audio
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Polices hébergées (noms non versionnés : cache d’un mois)
/fonts/*
  Cache-Control: public, max-age=2592000

# Illustrations des fiches (noms non versionnés, refaites sous le même nom par
# films.py) : un jour, pas plus — une image remplacée doit arriver vite.
/illustrations/*
  Cache-Control: public, max-age=86400

# HTML : AUCUNE règle Cache-Control. Le défaut de Cloudflare Pages
# (public, max-age=0, must-revalidate + ETag) revalide chaque page à chaque visite.
# Ne jamais poser Cache-Control sur /* (Pages concatène les valeurs de toutes
# les règles qui s'appliquent : _astro/* recevrait deux max-age), ni sur un
# dossier qui porte aussi des pages (L82 : l'ancienne règle d'images /films/*
# servait /films/avatar-2009/ 30 jours). Contrôlé par scripts/cache-headers.test.mjs.
