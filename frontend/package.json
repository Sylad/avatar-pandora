{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node ../scripts/lib/astro-node.mjs dev",
    "build": "node ../scripts/lib/astro-node.mjs build",
    "preview": "node ../scripts/lib/astro-node.mjs preview",
    "news": "rm -rf public/nouveautes-data && cadence news build -o public/nouveautes-data && rm -f public/nouveautes-data/index.html",
    "astro": "node ../scripts/lib/astro-node.mjs",
    "pretest:scripts": "node ../scripts/lib/require-dist.mjs",
    "test:scripts": "node --test --test-concurrency=${CADENCE_TEST_WORKERS:-4} ../scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "three": "^0.170.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright-core": "1.65.1"
  }
}
